<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Forgot Password | Pastors LMS' %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body class="login-body">
  <%- include('partials/header') %>

  <div class="login-viewport-content">
    <div class="login-container">

      <!-- Top Branding -->
      <!-- <div class="login-top-brand">
        <a href="/" class="login-brand-link" title="Pastors LMS Home">
          <img src="/images/IDA-Logo-White.webp" alt="Pastors LMS" class="main-portal-logo" width="157" height="120">
          <div class="brand-headings">
            <h1 class="brand-title">PASTORS <span class="brand-accent">LMS</span></h1>
            <span class="brand-sub">INTENTIONAL DISCIPLESHIP AFRICA</span>
          </div>
        </a>
      </div> -->

      <!-- Main Card -->
      <div class="login-card">
        <div class="card-intro">
          <h2 class="card-title">Reset Your Password</h2>
          <p class="card-subtitle">
            Enter your Phone Number, Email, or Username below and we will help you regain access.
          </p>
        </div>

        <!-- Error Message -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="portal-alert portal-alert-danger" role="alert">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="alert-icon">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <div class="alert-body">
              <%= error %>
            </div>
          </div>
        <% } %>

        <!-- Success Message -->
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="portal-alert" style="background: #ecfdf5; border: 1.5px solid #10b981; color: #065f46; border-radius: 10px; padding: 16px; margin-bottom: 24px;" role="status">
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <span style="font-size: 24px;">✅</span>
              <div>
                <strong style="display: block; font-size: 1.05rem; margin-bottom: 4px;">Password Updated!</strong>
                <p style="margin: 0; font-size: 0.95rem; line-height: 1.5;"><%= success.message %></p>
              </div>
            </div>
          </div>

          <div style="text-align: center; margin: 24px 0;">
            <a href="/login?username=<%= encodeURIComponent(identifier || '') %>" class="btn-primary-large" style="width: 100%; justify-content: center; text-decoration: none;">
              <span>Sign In with New Password</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          </div>
        <% } else { %>

          <!-- Direct Password Reset Form (Requires Both Email/Username + Registered Phone Verification) -->
          <form action="/forgot-password" method="POST" class="portal-form" id="forgotForm">
            <div class="form-field-group">
              <label class="field-label" for="resetIdentifier">
                1. Your Registered Email or Username
              </label>
              <span class="field-help-text">
                Enter your registered email address (e.g. <strong>pastor@church.org</strong>) or student username (e.g. <strong>p1000001</strong>).
              </span>
              <input 
                type="text" 
                id="resetIdentifier" 
                name="identifier" 
                class="field-input" 
                placeholder="e.g. pastor@church.org or p1000001" 
                value="<%= typeof identifier !== 'undefined' ? identifier : '' %>" 
                required 
                autofocus
              >
            </div>

            <div class="form-field-group">
              <label class="field-label" for="resetPhone">
                2. Verify Your Registered Phone Number
              </label>
              <span class="field-help-text">
                For your security, enter the mobile number registered on your profile (e.g. <strong>0712 345 678</strong>).
              </span>
              <input 
                type="tel" 
                id="resetPhone" 
                name="phone" 
                class="field-input" 
                placeholder="e.g. 0712 345 678" 
                value="<%= typeof phone !== 'undefined' ? phone : '' %>" 
                required
              >
            </div>

            <div class="form-field-group">
              <label class="field-label" for="resetNewPassword">New Password</label>
              <div class="password-input-wrap">
                <input 
                  type="password" 
                  id="resetNewPassword" 
                  name="new_password" 
                  class="field-input password-field" 
                  placeholder="Create a new password (min 6 characters)" 
                  minlength="6"
                  required 
                  autocomplete="new-password"
                >
                <button type="button" class="btn-pw-toggle" data-toggle-target="resetNewPassword" aria-label="Toggle password visibility">
                  <span class="pw-toggle-icon">👁️</span>
                  <span class="pw-toggle-text">Show</span>
                </button>
              </div>
            </div>

            <div class="form-field-group">
              <label class="field-label" for="resetConfirmPassword">Confirm New Password</label>
              <div class="password-input-wrap">
                <input 
                  type="password" 
                  id="resetConfirmPassword" 
                  name="confirm_password" 
                  class="field-input password-field" 
                  placeholder="Confirm your new password" 
                  minlength="6"
                  required 
                  autocomplete="new-password"
                >
                <button type="button" class="btn-pw-toggle" data-toggle-target="resetConfirmPassword" aria-label="Toggle password visibility">
                  <span class="pw-toggle-icon">👁️</span>
                  <span class="pw-toggle-text">Show</span>
                </button>
              </div>
            </div>

            <button type="submit" class="btn-primary-large" id="btnSubmitForgot" style="margin-top: 8px;">
              <span>Reset My Password Now</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </button>
          </form>

          <div class="card-footer-nav" style="text-align: center; margin-top: 20px;">
            <p>Remember your password? <a href="/login" style="font-weight: 700; color: var(--portal-primary);">Sign In here</a></p>
          </div>
        <% } %>

      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
