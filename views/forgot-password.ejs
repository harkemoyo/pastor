<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Forgot Password | Pastors LMS' %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body class="login-body">
  <%- include('partials/header') %>

  <div class="login-viewport-content">
    <div class="login-container">

      <!-- Top Branding -->
      <div class="login-top-brand">
        <a href="/" class="login-brand-link" title="Pastors LMS Home">
          <img src="/images/IDA-Logo-White.webp" alt="Pastors LMS" class="main-portal-logo" width="157" height="120">
          <div class="brand-headings">
            <h1 class="brand-title">PASTORS <span class="brand-accent">LMS</span></h1>
            <span class="brand-sub">INTENTIONAL DISCIPLESHIP AFRICA</span>
          </div>
        </a>
      </div>

      <!-- Main Card -->
      <div class="login-card">
        <div class="card-intro">
          <h2 class="card-title">Reset Your Password</h2>
          <p class="card-subtitle">
            Enter your Phone Number, Email, or Username below and we will help you regain access.
          </p>
        </div>

        <!-- Error Message -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="portal-alert portal-alert-danger" role="alert">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="alert-icon">
              <circle cx="12" cy="12" r="10" />
              <line x1="12" y1="8" x2="12" y2="12" />
              <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <div class="alert-body">
              <%= error %>
            </div>
          </div>
        <% } %>

        <!-- Success Message -->
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="portal-alert" style="background: #ecfdf5; border: 1.5px solid #10b981; color: #065f46; border-radius: 10px; padding: 16px; margin-bottom: 24px;" role="status">
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <span style="font-size: 24px;">✅</span>
              <div>
                <strong style="display: block; font-size: 1.05rem; margin-bottom: 4px;">Request Received!</strong>
                <p style="margin: 0; font-size: 0.95rem; line-height: 1.5;"><%= success.message %></p>
              </div>
            </div>
          </div>

          <div style="text-align: center; margin: 24px 0;">
            <a href="<%= success.waUrl %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp" id="btnForgotWhatsApp" style="display: inline-flex; width: 100%; justify-content: center; padding: 14px; font-size: 1rem;">
              <span>💬 Message Admin on WhatsApp Now</span>
            </a>
            <div style="margin-top: 18px;">
              <a href="/login" class="btn btn-secondary" style="width: 100%; justify-content: center; text-decoration: none;">
                Return to Sign In
              </a>
            </div>
          </div>
        <% } else { %>

          <!-- Reset Request Form -->
          <form action="/forgot-password" method="POST" class="portal-form" id="forgotForm">
            <div class="form-field-group">
              <label class="field-label" for="resetIdentifier">
                Your Phone Number, Email, or Username
              </label>
              <span class="field-help-text">
                Enter the mobile number (e.g. <strong>0712 345 678</strong>), email, or username registered on your profile.
              </span>
              <input 
                type="text" 
                id="resetIdentifier" 
                name="identifier" 
                class="field-input" 
                placeholder="e.g. 0712 345 678 or pastor@church.org" 
                value="<%= typeof identifier !== 'undefined' ? identifier : '' %>" 
                required 
                autofocus
              >
            </div>

            <button type="submit" class="btn-primary-large" id="btnSubmitForgot" style="margin-top: 8px;">
              <span>Request Password Reset</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </button>
          </form>

          <!-- Pastoral Help Box -->
          <div class="pastor-help-card" style="margin-top: 24px;">
            <div class="help-card-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <div class="help-card-content">
              <div>
                <h4>Need Immediate Help?</h4>
                <p>Call or WhatsApp IDA Pastoral Administration directly:</p>
              </div>
              <a href="https://wa.me/254707821269?text=Hello%20Pastor%20Hark,%20I%20need%20help%20recovering%20my%20Pastors%20LMS%20password." 
                 target="_blank" 
                 rel="noopener noreferrer" 
                 class="btn-whatsapp"
                 id="btnDirectWhatsAppForgot">
                <span>💬 WhatsApp Administrator (+254 707 821 269)</span>
              </a>
            </div>
          </div>

          <div class="card-footer-nav" style="text-align: center; margin-top: 20px;">
            <p>Remember your password? <a href="/login" style="font-weight: 700; color: var(--portal-primary);">Sign In here</a></p>
          </div>
        <% } %>

      </div>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
