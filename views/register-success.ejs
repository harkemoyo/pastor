<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title || 'Application Submitted | Pastors LMS' %>
  </title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body class="login-body">
  <%- include('partials/header') %>

  <div class="login-viewport-content">
    <div class="login-card">
      <div class="login-header">
        <div class="success-icon">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
        </div>
        <h1 class="login-title">Account Created!</h1>
        <p class="login-subtitle">Your account is ready. Your details have been saved successfully.</p>
      </div>

      <div class="success-content">
        <div class="info-box" style="border: 2px solid #670C21; background: #FCFDFD; border-radius: 12px; padding: 22px;">
          <h3 style="margin-top: 0; color: #192F47; font-size: 1.25rem;">🎉 Your Sign-In Credentials</h3>
          <p style="font-size: 0.92rem; color: #5B656B; margin-bottom: 16px;">
            Please note down or save your login details. You can sign in using <strong>any</strong> of the options below:
          </p>

          <div class="info-row" style="background: #ffffff; padding: 10px 14px; border-radius: 8px; margin-bottom: 8px; border: 1px solid #e5e0d3;">
            <span class="info-label" style="font-weight: 700; color: #192F47;">👤 Your Username:</span>
            <span class="info-value" style="font-size: 1.15rem; font-weight: 800; color: #192F47; background: #F4F0E7; padding: 3px 10px; border-radius: 6px;">
              <%= typeof username !== 'undefined' ? username : '' %>
            </span>
          </div>

          <% if (typeof student_id !== 'undefined' && student_id) { %>
            <div class="info-row" style="background: #ffffff; padding: 10px 14px; border-radius: 8px; margin-bottom: 8px; border: 1px solid #e5e0d3;">
              <span class="info-label" style="font-weight: 700;">🪪 Student ID:</span>
              <span class="info-value" style="font-weight: 700; color: #0B192C;">
                <%= student_id %>
              </span>
            </div>
          <% } %>

          <% if (typeof phone !== 'undefined' && phone) { %>
            <div class="info-row" style="background: #ffffff; padding: 10px 14px; border-radius: 8px; margin-bottom: 8px; border: 1px solid #e5e0d3;">
              <span class="info-label" style="font-weight: 700;">📱 Registered Phone:</span>
              <span class="info-value" style="font-weight: 600;">
                <%= phone %>
              </span>
            </div>
          <% } %>

          <div class="info-row" style="background: #ffffff; padding: 10px 14px; border-radius: 8px; margin-bottom: 8px; border: 1px solid #e5e0d3;">
            <span class="info-label" style="font-weight: 700;">✉️ Registered Email:</span>
            <span class="info-value" style="font-weight: 600;">
              <%= typeof email !== 'undefined' ? email : '' %>
            </span>
          </div>

          <div class="info-row" style="background: #ffffff; padding: 10px 14px; border-radius: 8px; border: 1px solid #e5e0d3;">
            <span class="info-label" style="font-weight: 700;">✅ Account Status:</span>
            <span class="info-value" style="color: #059669; font-weight: 700;">
              Active &amp; Approved
            </span>
          </div>
        </div>

        <div class="action-buttons" style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
          <a href="/login?username=<%= encodeURIComponent(typeof username !== 'undefined' ? username : '') %>" class="btn btn-primary"
            style="flex: 1; min-width: 200px; text-decoration: none; justify-content: center; font-size: 1.05rem; padding: 14px 20px;">
            Sign In with <%= typeof username !== 'undefined' ? username : 'Your Account' %> &rarr;
          </a>
          <a href="/onboarding" class="btn btn-secondary" style="flex: 1; min-width: 160px; text-decoration: none; justify-content: center;">
            View Orientation Guide
          </a>
        </div>
      </div>

      <p class="login-footer-note">
        “Holding fast the faithful word as taught, that he may be able by sound doctrine to exhort.” — Titus 1:9
      </p>
    </div>
  </div>

  <%- include('partials/footer') %>

  <style>
    .login-brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      margin-bottom: 24px;
    }

    .login-logo {
      height: 110px;
      width: auto;
      flex-shrink: 0;
      object-fit: contain;
    }

    .login-brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
      text-align: left;
    }

    .login-brand-title {
      font-family: var(--font-heading);
      font-size: 1.8rem;
      font-weight: 800;
      color: var(--primary-dark);
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    .login-brand-accent {
      color: var(--accent);
    }

    .login-brand-tagline {
      font-family: var(--font-heading);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 1.2px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    @media (max-width: 480px) {
      .login-brand {
        flex-direction: column;
        gap: 12px;
      }

      .login-brand-text {
        text-align: center;
      }

      .login-logo {
        height: 84px;
      }

      .login-brand-title {
        font-size: 1.4rem;
      }

      .login-brand-tagline {
        font-size: 0.65rem;
      }
    }

    .success-icon {
      color: #1B7A4B;
      margin-bottom: 1rem;
    }

    .success-content {
      margin-top: 2rem;
    }

    .info-box {
      background: #FCFDFD;
      border: 1px solid #E5DFD5;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .info-box h3 {
      margin: 0 0 1rem 0;
      color: #192F47;
      font-size: 1.1rem;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0;
      border-bottom: 1px solid #E5DFD5;
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .info-label {
      color: #5B656B;
      font-weight: 500;
    }

    .info-value {
      color: #0B192C;
      font-weight: 600;
    }

    .next-steps {
      margin-bottom: 2rem;
    }

    .next-steps h3 {
      margin: 0 0 1rem 0;
      color: #192F47;
      font-size: 1.1rem;
    }

    .next-steps ol {
      margin: 0;
      padding-left: 1.5rem;
      color: #30383A;
    }

    .next-steps li {
      margin-bottom: 0.5rem;
    }

    .action-buttons {
      display: flex;
      gap: 1rem;
    }
  </style>
  <script src="/js/app.js"></script>
</body>

</html>