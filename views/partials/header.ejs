<header class="top-navbar">
  <div class="nav-container">
    <div class="nav-brand">
      <a href="/" title="Pastors LMS Home" class="nav-brand-link">
        <img src="/images/IDA-Logo-White.webp" alt="Pastors LMS - Intentional Discipleship Africa" class="nav-logo" width="72" height="58">
        <div class="nav-brand-text">
          <div class="nav-brand-title">PASTORS <span class="nav-brand-accent">LMS</span></div>
        </div>
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <svg class="icon-hamburger" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
      <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <nav class="nav-links" id="navLinks" aria-label="Main navigation">
      <li class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/courses')) ? 'active' : '' %>">
        <a href="/courses" id="navMyCourses">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" /><path d="M6 6h10" /><path d="M6 10h10" /></svg>
          <span>My Courses</span>
        </a>
      </li>
      <li class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/library')) ? 'active' : '' %>">
        <a href="/library" id="navLibrary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 6 4 14" /><path d="M12 6v14" /><path d="M8 8v12" /><path d="M4 4v16" /></svg>
          <span>Library</span>
        </a>
      </li>
      <% if (locals.user && ['teacher', 'admin', 'super_admin'].includes(user.role)) { %>
        <li class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/teacher')) ? 'active' : '' %>">
          <a href="/teacher/library" id="navTeacher">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" /></svg>
            <span>Teacher</span>
          </a>
        </li>
      <% } %>
    </nav>

    <div class="nav-right">
      <div class="nav-clock" id="navClock" title="Local time">
        <span class="nav-flag" id="navFlag" role="img" aria-label="Country flag">🌍</span>
        <span id="liveClock">Loading...</span>
      </div>

      <% if (locals.user) { %>
        <div class="user-profile-btn" title="<%= user.full_name %>">
          <div class="user-avatar">
            <%= user.initials || 'P' %>
          </div>
          <div class="user-info">
            <div class="user-name">
              <%= user.full_name %>
            </div>
          </div>
        </div>
        <% if (['admin', 'super_admin'].includes(user.role)) { %>
          <div class="admin-menu-wrapper">
            <button class="admin-menu-toggle" id="adminMenuToggle" aria-label="Toggle admin menu" aria-expanded="false">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
              </svg>
              <span>Admin</span>
            </button>
            <div class="admin-dropdown" id="adminDropdown">
              <a href="/admin" class="admin-dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect width="7" height="9" x="3" y="3" rx="1" />
                  <rect width="7" height="5" x="14" y="3" rx="1" />
                  <rect width="7" height="9" x="14" y="12" rx="1" />
                  <rect width="7" height="5" x="3" y="16" rx="1" />
                </svg>
                <span>Dashboard</span>
              </a>
              <a href="/admin/students" class="admin-dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                <span>Students</span>
              </a>
              <a href="/admin/courses" class="admin-dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
                  <path d="M6 6h10" />
                  <path d="M6 10h10" />
                </svg>
                <span>Courses</span>
              </a>
              <a href="/admin/enrolments" class="admin-dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <line x1="19" y1="8" x2="19" y2="14" />
                  <line x1="22" y1="11" x2="16" y2="11" />
                </svg>
                <span>Enrolments</span>
              </a>
              <a href="/admin/activity" class="admin-dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path
                    d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
                </svg>
                <span>Activity Log</span>
              </a>
              <a href="/admin/profile" class="admin-dropdown-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
                <span>My Profile</span>
              </a>
            </div>
          </div>
          <% } %>
            <a href="/logout" class="btn-logout-link" title="Sign out of Pastors LMS">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              <span>Logout</span>
            </a>
            <% } else { %>
              <a href="/login" class="btn btn-gold btn-sm">Sign In</a>
              <% } %>
    </div>
  </div>
</header>
