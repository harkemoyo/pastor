<header class="top-navbar">
  <div class="nav-container">
    <div class="nav-brand">
      <a href="/" title="Pastors LMS Home" class="nav-brand-link">
        <img src="/images/ida-logo.jpg" alt="Intentional Discipleship Africa" class="nav-logo">
        <div class="nav-brand-text">
          <div class="nav-brand-title">PASTORS <span class="nav-brand-accent">LMS</span></div>
          <div class="nav-brand-tagline">EQUIPPING FAITHFUL SHEPHERDS</div>
        </div>
      </a>
    </div>

    <nav class="nav-links">
      <li class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active' : '' %>">
        <a href="/">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <polyline points="9 22 9 12 15 12 15 22" />
          </svg>
          Dashboard
        </a>
      </li>
      <li
        class="nav-item <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/courses')) ? 'active' : '' %>">
        <a href="/">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
            <path d="M6 6h10" />
            <path d="M6 10h10" />
          </svg>
          My Courses
        </a>
      </li>
      <li class="nav-item">
        <a href="#resources"
          onclick="alert('Theological Resource Library: Includes Swahili study notes, ESV/Swahili Bible cross-references, and pastoral ministry templates.')">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 6 4 14" />
            <path d="M12 6v14" />
            <path d="M8 8v12" />
            <path d="M4 4v16" />
          </svg>
          Library
        </a>
      </li>
    </nav>

    <div class="nav-right">
      <div class="nav-clock" title="East Africa Time (EAT)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <circle cx="12" cy="12" r="10" />
          <polyline points="12 6 12 12 16 14" />
        </svg>
        <span id="liveClock">Loading EAT...</span>
      </div>

      <% if (locals.user) { %>
        <div class="user-profile-btn">
          <div class="user-avatar" title="<%= user.full_name %>">
            <%= user.initials || 'P' %>
          </div>
          <div class="user-info">
            <div class="user-name">
              <%= user.full_name %>
            </div>
            <div class="user-role">
              <%= user.role==='admin' ? 'Curriculum Admin' : 'Pastor / Scholar' %>
            </div>
          </div>
        </div>
        <% if (user.role==='admin' ) { %>
          <a href="/admin/users" class="btn-admin-link" title="Manage Users">Users</a>
          <a href="/admin/courses" class="btn-admin-link" title="Manage Courses">Courses</a>
          <% } %>
            <a href="/logout" class="btn-logout-link" title="Sign out of Pastors LMS">Logout</a>
            <% } else { %>
              <a href="/login" class="btn btn-gold btn-sm">Sign In</a>
              <% } %>
    </div>
  </div>
</header>