<aside class="sidebar-panel">
  <div class="sidebar-title">
    <span>Work To Do</span>
    <span class="sidebar-count-badge"><%= (typeof tasks !== 'undefined' && tasks) ? tasks.length : 0 %> pending</span>
  </div>

  <div class="task-list">
    <% if (typeof tasks !== 'undefined' && tasks && tasks.length > 0) { %>
      <% tasks.forEach(task => { %>
        <div class="task-card">
          <div class="task-header">
            <span class="task-type-badge <%= task.type %>">
              <%= task.type === 'forum' ? 'Discussion' : (task.type === 'quiz' ? 'Self-Quiz' : 'Assignment') %>
            </span>
            <span class="task-due">
              <% if (task.starts) { %>
                Starts <%= task.starts %>
              <% } else { %>
                Due <%= new Date(task.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
              <% } %>
            </span>
          </div>
          <div class="task-title"><%= task.title %></div>
          <div class="task-course-code"><%= task.course_code %></div>
        </div>
      <% }); %>
    <% } else { %>
      <p style="font-size: 0.86rem; color: var(--text-muted); text-align: center; padding: 20px 0;">
        🎉 All caught up! No pending coursework.
      </p>
    <% } %>
  </div>

  <!-- Pastoral Mentorship & Support -->
  <div class="ministry-help-box">
    <div class="help-box-title">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      Faculty Shepherd Support
    </div>
    <div class="help-box-text">
      Questions on sermon preparation or doctrinal exegesis? Reach out to your cohort mentor via WhatsApp or email.
    </div>
    <a href="mailto:mentors@pastorslms.com" class="btn btn-outline btn-sm" style="width: 100%; justify-content: center;">
      Contact Cohort Mentor
    </a>
  </div>
</aside>
