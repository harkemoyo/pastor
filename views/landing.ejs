  <meta name="description" content="Free, church-centred theological training for pastors across East Africa by Intentional Discipleship Africa. Apply today.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/landing.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body class="landing-body">
  <header class="landing-nav">
    <div class="landing-nav-bar">
      <!-- Left: Mobile menu toggle -->
      <button type="button" class="landing-mobile-toggle" id="landingMobileToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="landingNavMenu">
        <svg class="icon-hamburger" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Center: Logo -->
      <a href="/" class="landing-logo">
        <img src="/images/IDA-Logo-Complete.webp" alt="Pastors LMS - Intentional Discipleship Africa" width="130" height="100">
        <span>PASTORS <b>LMS</b></span>
      </a>

      <!-- Right: Log In with popup -->
      <div class="nav-dropdown" id="loginDropdown">
        <button type="button" class="btn-ghost nav-dropdown-toggle" id="loginToggle" aria-haspopup="true" aria-expanded="false" aria-controls="loginMenu">Log In <span class="caret" aria-hidden="true">&#9662;</span></button>
        <div class="nav-dropdown-menu" id="loginMenu" role="menu">
          <a href="/login" role="menuitem"><strong>Student Portal</strong><small>I already have an account</small></a>
          <a href="/register" role="menuitem"><strong>Sign Up / Register</strong><small>Don't have an account?</small></a>
        </div>
      </div>

      <a href="/register" class="btn-cta desktop-cta">Sign Up</a>
    </div>

    <!-- Navigation links (desktop header / mobile dropdown) -->
    <nav class="landing-nav-menu" id="landingNavMenu">
      <a href="#programs">Programs</a>
      <a href="#about">About</a>
      <a href="#faq">FAQ</a>
      <a href="/register" class="btn-cta mobile-menu-cta">Sign Up</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-inner reveal">
        <span class="hero-pill">Free training for pastors &amp; church leaders</span>
        <h1>Equipping <span class="accent-red">Faithful</span> Shepherds Across East Africa</h1>
        <p class="hero-sub">Learn the Bible and lead your church well &mdash; from your phone, at your own pace.</p>
        <div class="hero-actions">
          <a href="/register" class="btn-cta btn-lg">Sign Up</a>
          <a href="#programs" class="btn-ghost btn-lg">See Programs</a>
        </div>
      </div>
      <figure class="hero-photo reveal">
        <img src="/images/Ps-Imgs/IMG_20260930_141326.webp" alt="A pastor studying Scripture and his course on a phone" width="1200" height="900">
      </figure>
    </section>

    <section class="stats">
      <div class="stat reveal"><strong data-count="1200" data-suffix="+">1,200+</strong><span>Pastors trained</span></div>
      <div class="stat reveal"><strong data-count="600" data-suffix="+">600+</strong><span>Churches served</span></div>
      <div class="stat reveal"><strong data-count="25">25</strong><span>Counties reached</span></div>
      <div class="stat reveal"><strong data-count="4">4</strong><span>Core programs</span></div>
    </section>

    <section id="programs" class="section">
      <h2 class="reveal">Our Programs</h2>
      <div class="cards">
        <a class="card card-link reveal" href="/register?program=hermeneutics"><img src="/images/course-hermeneutics.svg" alt=""><h3>Biblical Hermeneutics</h3><p>Handle Scripture accurately and preach with confidence.</p><span class="card-cta">Apply for this program &rarr;</span></a>
        <a class="card card-link reveal" href="/register?program=leadership"><img src="/images/course-leadership.svg" alt=""><h3>Pastoral Leadership</h3><p>Lead, shepherd and steward your congregation well.</p><span class="card-cta">Apply for this program &rarr;</span></a>
        <a class="card card-link reveal" href="/register?program=counseling"><img src="/images/course-counseling.svg" alt=""><h3>Biblical Counseling</h3><p>Care for hurting people with wisdom and compassion.</p><span class="card-cta">Apply for this program &rarr;</span></a>
        <a class="card card-link reveal" href="/register?program=worship"><img src="/images/course-worship.svg" alt=""><h3>Worship &amp; Ministry</h3><p>Cultivate Christ-centred worship in your church.</p><span class="card-cta">Apply for this program &rarr;</span></a>
      </div>
    </section>

    <section id="about" class="section alt">
      <div class="about reveal">
        <h2>Our Mission</h2>
        <p>Many pastors in East Africa lead faithfully without access to formal theological education. Pastors LMS brings structured, affordable and church-centred training to them &mdash; so healthy shepherds build healthy churches.</p>
      </div>
    </section>

    <section id="partners" class="section partners">
      <p class="eyebrow eyebrow-dark reveal">Walking Together</p>
      <h2 class="reveal">Our Partners</h2>
      <p class="partners-sub reveal">Churches and ministries who stand with us to equip shepherds across Africa.</p>
      <ul class="partner-logos">
        <li class="reveal"><img src="/images/partners/cba.webp" alt="Crossover Basketball Ambassadors" loading="lazy"></li>
        <li class="reveal"><img src="/images/partners/acfar.webp" alt="Africa Centre for Apologetics Research" loading="lazy"></li>
        <li class="reveal"><img src="/images/partners/injili.webp" alt="Injili Ministries" loading="lazy"></li>
        <li class="reveal"><img src="/images/partners/firm-foundation.webp" alt="Firm Foundation Ministries" loading="lazy"></li>
        <li class="reveal"><img src="/images/partners/word-for-the-world.webp" alt="The Word for the World Bible Translators" loading="lazy"></li>
      </ul>
    </section>

    <section id="stories" class="section">
      <h2 class="reveal">Stories from Pastors</h2>
      <div class="cards three">
        <blockquote class="card reveal">&ldquo;The course changed how I prepare every sermon.&rdquo;<cite>&mdash; Pastor, Nakuru</cite></blockquote>
        <blockquote class="card reveal">&ldquo;I can study between services &mdash; right from my phone.&rdquo;<cite>&mdash; Pastor, Kisumu</cite></blockquote>
        <blockquote class="card reveal">&ldquo;Counseling training equipped me for real situations.&rdquo;<cite>&mdash; Pastor, Eldoret</cite></blockquote>
      </div>
    </section>

    <section id="faq" class="section alt">
      <h2 class="reveal">Frequently Asked Questions</h2>
      <div class="faq">
        <details class="reveal"><summary>Who can apply?</summary><p>Any pastor or church leader actively serving in ministry.</p></details>
        <details class="reveal"><summary>How does the application work?</summary><p>Register, complete the onboarding steps, and wait for approval from the admissions team.</p></details>
        <details class="reveal"><summary>Can I study on my phone?</summary><p>Yes. The portal is fully mobile-friendly.</p></details>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    // Animated stat counters
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counterIO = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        counterIO.unobserve(el);
        if (reduceMotion) return;
        const end = +el.dataset.count, suffix = el.dataset.suffix || '', dur = 1600, start = performance.now();
        const tick = (now) => {
          const p = Math.min((now - start) / dur, 1), eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(end * eased).toLocaleString('en-US') + (p === 1 ? suffix : '');
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    document.querySelectorAll('[data-count]').forEach(el => counterIO.observe(el));

    // Dropdowns: Navigation menu (left) and Login popup (right)
    const mobileToggle = document.getElementById('landingMobileToggle');
    const navMenu = document.getElementById('landingNavMenu');
    const loginToggle = document.getElementById('loginToggle');
    const loginDropdown = document.getElementById('loginDropdown');

    const setNavOpen = (open) => {
      if (!navMenu || !mobileToggle) return;
      navMenu.classList.toggle('open', open);
      mobileToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open && loginDropdown) setLoginOpen(false);
    };

    const setLoginOpen = (open) => {
      if (!loginDropdown || !loginToggle) return;
      loginDropdown.classList.toggle('open', open);
      loginToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open && navMenu) setNavOpen(false);
    };

    if (mobileToggle) {
      mobileToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setNavOpen(!navMenu.classList.contains('open'));
      });
    }

    if (loginToggle) {
      loginToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setLoginOpen(!loginDropdown.classList.contains('open'));
      });
    }

    document.addEventListener('click', (e) => {
      if (navMenu && !navMenu.contains(e.target) && mobileToggle && !mobileToggle.contains(e.target)) {
        setNavOpen(false);
      }
      if (loginDropdown && !loginDropdown.contains(e.target)) {
        setLoginOpen(false);
      }
    });

    if (navMenu) {
      navMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => setNavOpen(false));
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setNavOpen(false);
        setLoginOpen(false);
      }
    });
  </script>
</body>
</html>
