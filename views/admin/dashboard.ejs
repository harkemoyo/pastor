<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body class="app-container">
  <%- include('../partials/header') %>
  <main class="admin-page">
    <div class="admin-topbar">
      <div>
        <div style="margin-bottom: 6px;">
          <span class="badge" style="background: #670C21; color: #FFFFFF; font-weight: 700; padding: 4px 12px; border-radius: 999px; font-size: 0.8rem;">
            <%= (user && user.role === 'super_admin') ? '👑 SUPER ADMIN PORTAL' : '🛡️ ADMIN PORTAL' %>
          </span>
        </div>
        <h1 class="admin-title">Welcome, <%= user ? user.full_name : 'Administrator' %></h1>
        <div class="admin-subtitle">Manage students, teachers, admins, courses, and learning materials in one place</div>
      </div>
      <div class="admin-actions" style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a href="/admin/students" class="btn btn-secondary">👥 All Students &amp; Staff</a>
        <a href="/admin/students/new" class="btn btn-primary">+ Register Person (Student / Teacher / Admin)</a>
        <a href="/admin/courses" class="btn btn-secondary">📚 Courses</a>
        <a href="/teacher/library" class="btn btn-secondary">📖 Library</a>
      </div>
    </div>

    <div class="admin-grid">
      <div class="admin-stat">
        <div class="icon">👥</div>
        <div><div class="number"><%= stats.totalStudents %></div><div class="label">Total Students</div></div>
      </div>
      <div class="admin-stat">
        <div class="icon">✅</div>
        <div><div class="number"><%= stats.activeStudents %></div><div class="label">Active Students</div></div>
      </div>
      <div class="admin-stat">
        <div class="icon">🟡</div>
        <div><div class="number"><%= stats.inactiveStudents %></div><div class="label">Inactive Students</div></div>
      </div>
      <div class="admin-stat">
        <div class="icon">🎓</div>
        <div><div class="number"><%= stats.graduatedStudents %></div><div class="label">Graduated Students</div></div>
      </div>
      <div class="admin-stat">
        <div class="icon">📚</div>
        <div><div class="number"><%= stats.totalCourses %></div><div class="label">Total Courses</div></div>
      </div>
      <div class="admin-stat">
        <div class="icon">📖</div>
        <div><div class="number"><%= stats.activeCourses %></div><div class="label">Active Courses</div></div>
      </div>
      <div class="admin-stat">
        <div class="icon">🧾</div>
        <div><div class="number"><%= stats.totalEnrolments %></div><div class="label">Total Enrolments</div></div>
      </div>
    </div>

    <div class="detail-grid">
      <section class="admin-surface">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
          <h2 style="margin: 0;">Recent Accounts &amp; Registrations</h2>
          <a href="/admin/students" class="btn btn-sm btn-secondary">View All &rarr;</a>
        </div>
        <% if (recentRegistrations.length) { %>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr><th>Name</th><th>Username / ID</th><th>Role</th><th>Action</th></tr>
              </thead>
              <tbody>
                <% recentRegistrations.forEach(student => { %>
                  <tr>
                    <td>
                      <strong><%= student.full_name || [student.first_name, student.last_name].filter(Boolean).join(' ') %></strong>
                      <div style="font-size: 0.8rem; color: #6b7280;"><%= student.email %></div>
                    </td>
                    <td><code>@<%= student.username || student.student_id || 'N/A' %></code></td>
                    <td>
                      <span class="badge" style="background: <%= (student.role === 'admin' || student.role === 'super_admin') ? '#670C21' : (student.role === 'teacher' ? '#D97706' : '#192F47') %>; color: #fff; font-size: 0.72rem;">
                        <%= (student.role || 'student').toUpperCase() %>
                      </span>
                    </td>
                    <td>
                      <a href="/admin/students/<%= student.student_id || student.username %>" class="btn btn-sm btn-secondary">Manage</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No student registrations yet.</div>
        <% } %>
      </section>

      <section class="admin-surface">
        <h2>Recent Admin Activity</h2>
        <% if (recentActivity.length) { %>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead>
                <tr><th>Action</th><th>Actor</th><th>Date</th></tr>
              </thead>
              <tbody>
                <% recentActivity.forEach(item => { %>
                  <tr>
                    <td><%= item.action %></td>
                    <td><%= item.admin_name %></td>
                    <td><%= new Date(item.created_at).toLocaleString() %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No admin activity recorded yet.</div>
        <% } %>
      </section>
    </div>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
