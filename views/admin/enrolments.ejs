<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body class="app-container">
  <%- include('../partials/header') %>
  <main class="admin-page">
    <div class="admin-topbar">
      <div>
        <h1 class="admin-title">Enrolments &amp; Term Registrations</h1>
        <div class="admin-subtitle">Approve pastor course registration requests, check prerequisites/load limits, and manage enrolments</div>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success" role="status"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>

    <!-- Pending Term Course Registration Requests (Phase 4) -->
    <% const pendingRegReqs = (typeof registrationRequests !== 'undefined' ? registrationRequests : []).filter(r => r.status === 'pending'); %>
    <section class="admin-surface admin-section-spaced" id="pendingRegistrationRequestsSection">
      <h3>Pending Term Registration Requests (<%= pendingRegReqs.length %>)</h3>
      <% if (pendingRegReqs.length === 0) { %>
        <p class="lecturer-subtitle">No pending course registration requests from pastors right now.</p>
      <% } else { %>
        <div class="admin-table-wrap">
          <table class="admin-table" id="regRequestsAdminTable">
            <thead>
              <tr>
                <th>Pastor</th>
                <th>Requested Course</th>
                <th>Term</th>
                <th>Requested</th>
                <th>Decision</th>
              </tr>
            </thead>
            <tbody>
              <% pendingRegReqs.forEach(reqItem => { %>
                <tr>
                  <td><strong><%= reqItem.student_name %></strong> (@<%= reqItem.student_username %>)</td>
                  <td><span class="badge course-badge"><%= reqItem.course_code %></span> <%= reqItem.course_title %></td>
                  <td><%= reqItem.term_code %></td>
                  <td><%= new Date(reqItem.created_at).toLocaleDateString() %></td>
                  <td>
                    <form method="POST" action="/admin/enrolments/requests/<%= reqItem.id %>/resolve" class="action-row-inline" id="regApproveForm-<%= reqItem.id %>">
                      <button type="submit" name="decision" value="approve" class="btn btn-primary btn-sm" id="btnApproveRegReq-<%= reqItem.id %>">Approve &amp; Enrol</button>
                      <button type="submit" name="decision" value="deny" class="btn btn-outline btn-sm" id="btnDenyRegReq-<%= reqItem.id %>">Decline</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="admin-surface admin-section-spaced">
      <h3>Create Enrolment</h3>
      <form method="POST" action="/admin/enrolments/new" class="filters-bar">
        <div class="filter-group" style="flex:1; min-width:220px;">
          <label>Student</label>
          <select name="student_id" required>
            <option value="">Select student</option>
            <% students.forEach(student => { %>
              <option value="<%= student.student_id || student.username %>"><%= student.full_name || [student.first_name, student.last_name].filter(Boolean).join(' ') %> (<%= student.student_id || 'N/A' %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group" style="flex:1; min-width:220px;">
          <label>Course</label>
          <select name="course_id" required>
            <option value="">Select course</option>
            <% courses.forEach(course => { %>
              <option value="<%= course.id %>"><%= course.title %> (<%= course.code %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group">
          <label>Status</label>
          <select name="status">
            <option value="active">Active</option>
            <option value="pending">Pending</option>
          </select>
        </div>
        <div class="filter-group">
          <button type="submit" class="btn btn-primary">Create Enrolment</button>
        </div>
      </form>
    </section>

    <section class="admin-surface" style="margin-top:1.5rem;">
      <form method="GET" action="/admin/enrolments" class="filters-bar">
        <div class="filter-group" style="flex:1; min-width:180px;">
          <label>Student</label>
          <select name="student_id">
            <option value="all">All students</option>
            <% students.forEach(student => { %>
              <option value="<%= student.student_id || student.username %>" <%= filters.student_id === (student.student_id || student.username) ? 'selected' : '' %>><%= student.full_name || [student.first_name, student.last_name].filter(Boolean).join(' ') %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group" style="flex:1; min-width:180px;">
          <label>Course</label>
          <select name="course_id">
            <option value="all">All courses</option>
            <% courses.forEach(course => { %>
              <option value="<%= course.id %>" <%= Number(filters.course_id) === Number(course.id) ? 'selected' : '' %>><%= course.title %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group" style="flex:1; min-width:180px;">
          <label>Status</label>
          <select name="status">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
          </select>
        </div>
        <div class="filter-group" style="flex:1; min-width:180px;">
          <label>Search</label>
          <input type="text" name="search" value="<%= filters.search %>" placeholder="Student or course" />
        </div>
        <div class="filter-group">
          <button type="submit" class="btn btn-primary">Apply</button>
        </div>
      </form>

      <% if (enrolments.length) { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Student</th><th>Course</th><th>Enrolment Date</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
              <% enrolments.forEach(item => { %>
                <tr>
                  <td><%= item.student_name %></td>
                  <td><%= item.course_name %> (<%= item.course_code %>)</td>
                  <td><%= new Date(item.enrolled_at).toLocaleDateString() %></td>
                  <td><span class="badge status-<%= item.status || 'active' %>"><%= (item.status || 'active').charAt(0).toUpperCase() + ((item.status || 'active').slice(1)) %></span></td>
                  <td>
                    <form method="POST" action="/admin/enrolments/<%= item.id %>/remove">
                      <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Remove this enrolment?')">Remove</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">No enrolments match the current filters.</div>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
