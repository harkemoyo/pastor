<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Live Session Timetable Manager | Pastors LMS Admin' %></title>
  <link rel="stylesheet" href="/css/global.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/dashboard.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/footer.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body class="app-container">
  <%- include('../partials/header') %>

  <main class="admin-page">
    <div class="admin-topbar">
      <div>
        <h1 class="admin-title">Live Session Timetable Manager</h1>
        <p class="admin-subtitle">
          Schedule live Zoom and hybrid seminars in East Africa Time (EAT). Automatic conflict detection prevents double-booking a lecturer, venue, or course slot.
        </p>
      </div>
      <div class="admin-actions">
        <a href="/admin/attendance" class="btn btn-secondary" id="btnAdminTimetableToAttendance">Attendance Reports</a>
        <a href="/admin/terms" class="btn btn-outline" id="btnAdminTimetableToTerms">Terms Manager</a>
      </div>
    </div>

    <% if (success) { %>
      <div class="alert alert-success" role="status"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>

    <!-- Schedule New Live Session -->
    <section class="admin-surface admin-section-spaced" id="adminTimetableCreateSection">
      <h2>Schedule Live Cohort Session</h2>
      <form method="POST" action="/admin/timetable/save" class="extension-form-grid" id="adminTimetableForm">
        <div>
          <label class="form-label" for="ttCourseSelect">Course *</label>
          <select id="ttCourseSelect" name="course_id" class="form-input" required>
            <% (courses || []).forEach(c => { %>
              <option value="<%= c.id %>"><%= c.code %> &mdash; <%= c.title %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="form-label" for="ttTitleInput">Session Title *</label>
          <input type="text" id="ttTitleInput" name="title" class="form-input" placeholder="e.g. Week 4 Live Exegesis Seminar" required>
        </div>
        <div>
          <label class="form-label" for="ttDateInput">Session Date (EAT) *</label>
          <input type="date" id="ttDateInput" name="session_date" class="form-input" value="<%= todayEat %>" required>
        </div>
        <div>
          <label class="form-label" for="ttStartInput">Start Time (EAT) *</label>
          <input type="time" id="ttStartInput" name="start_time" class="form-input" value="19:00" required>
        </div>
        <div>
          <label class="form-label" for="ttEndInput">End Time (EAT) *</label>
          <input type="time" id="ttEndInput" name="end_time" class="form-input" value="20:30" required>
        </div>
        <div>
          <label class="form-label" for="ttLecturerSelect">Lecturer</label>
          <select id="ttLecturerSelect" name="lecturer_username" class="form-input">
            <option value="">Use Course Assigned Lecturer</option>
            <% (teachers || []).forEach(t => { %>
              <option value="<%= t.username %>"><%= t.full_name %> (@<%= t.username %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="form-label" for="ttModeSelect">Session Mode</label>
          <select id="ttModeSelect" name="mode" class="form-input">
            <option value="Zoom / Online">Zoom / Online</option>
            <option value="Hybrid (Nairobi & Zoom)">Hybrid (Nairobi &amp; Zoom)</option>
            <option value="In-Person Cohort">In-Person Cohort</option>
          </select>
        </div>
        <div>
          <label class="form-label" for="ttVenueInput">Zoom Link or Venue *</label>
          <input type="text" id="ttVenueInput" name="venue_or_link" class="form-input" placeholder="https://zoom.us/j/... or Chapel Room" required>
        </div>
        <div class="extension-reason-field">
          <label class="form-label" for="ttNotesInput">Preparation Notes (Optional)</label>
          <input type="text" id="ttNotesInput" name="notes" class="form-input" placeholder="e.g. Read Unit 4 commentary before joining.">
        </div>
        <div class="extension-submit-wrap">
          <button type="submit" class="btn btn-primary" id="btnSaveLiveSession">Schedule Live Session</button>
        </div>
      </form>
    </section>

    <!-- Scheduled Live Sessions -->
    <section class="admin-surface" id="adminTimetableListSection">
      <h2>Scheduled Live Sessions (<%= sessions.length %>)</h2>
      <div class="admin-table-wrap">
        <table class="admin-table" id="adminTimetableTable">
          <thead>
            <tr>
              <th>Date &amp; Time (EAT)</th>
              <th>Course &amp; Title</th>
              <th>Lecturer</th>
              <th>Mode &amp; Venue / Link</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% (sessions || []).forEach(sess => { %>
              <tr id="adminSessRow-<%= sess.id %>">
                <td>
                  <strong><%= sess.session_date %></strong>
                  <div><%= sess.start_time %>&ndash;<%= sess.end_time %> EAT</div>
                </td>
                <td>
                  <span class="badge badge-purple"><%= sess.course_code %></span>
                  <div><strong><%= sess.title %></strong></div>
                </td>
                <td><%= sess.lecturer_name || sess.lecturer_username || 'Cohort Lecturer' %></td>
                <td>
                  <span class="session-mode-tag"><%= sess.mode %></span>
                  <div><small><%= sess.venue_or_link %></small></div>
                </td>
                <td>
                  <div class="action-row-inline">
                    <a href="/teacher/attendance?course_id=<%= sess.course_id %>&session_id=<%= sess.id %>" class="btn btn-secondary btn-sm" id="btnTakeAttForSess-<%= sess.id %>">Roll Call</a>
                    <form method="POST" action="/admin/timetable/<%= sess.id %>/delete">
                      <button type="submit" class="btn btn-outline btn-sm" id="btnDeleteSess-<%= sess.id %>">Remove</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
