<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Course Form | Pastors LMS' %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body class="app-container">
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="dashboard-header">
      <h1><%= mode === 'create' ? 'Create New Course' : 'Edit Course' %></h1>
      <a href="/admin/courses" class="btn btn-outline">← Back to Courses</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert">
        <%= error %>
      </div>
    <% } %>

    <div class="form-container">
      <form action="<%= mode === 'create' ? '/admin/courses/new' : `/admin/courses/${course.id}/edit` %>" method="POST">
        <div class="form-group">
          <label class="form-label" for="title">Course Title *</label>
          <input type="text" id="title" name="title" class="form-input" 
                 value="<%= mode === 'edit' && course ? course.title : '' %>" 
                 placeholder="e.g., Sound Doctrine & Biblical Theology" required>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="code">Course Code *</label>
            <input type="text" id="code" name="code" class="form-input" 
                   value="<%= mode === 'edit' && course ? course.code : '' %>" 
                   placeholder="e.g., THEO 101" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="term">Term *</label>
            <input type="text" id="term" name="term" class="form-input" 
                   value="<%= mode === 'edit' && course ? course.term : '' %>" 
                   placeholder="e.g., AY2027-T1" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">Course Description</label>
          <textarea id="description" name="description" class="form-input" rows="4"
                    placeholder="Enter a detailed description of the course..."><%= mode === 'edit' && course ? course.description : '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="start_date">Start Date</label>
            <input type="date" id="start_date" name="start_date" class="form-input" 
                   value="<%= mode === 'edit' && course ? course.start_date : '' %>">
          </div>

          <div class="form-group">
            <label class="form-label" for="end_date">End Date</label>
            <input type="date" id="end_date" name="end_date" class="form-input" 
                   value="<%= mode === 'edit' && course ? course.end_date : '' %>">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="status">Course Status</label>
          <select id="status" name="status" class="form-input">
            <option value="current" <%= mode === 'edit' && course?.status === 'current' ? 'selected' : '' %>>Current</option>
            <option value="past" <%= mode === 'edit' && course?.status === 'past' ? 'selected' : '' %>>Past</option>
            <option value="upcoming" <%= mode === 'edit' && course?.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            <%= mode === 'create' ? 'Create Course' : 'Update Course' %>
          </button>
          <a href="/admin/courses" class="btn btn-outline">Cancel</a>
        </div>
      </form>
    </div>
  </main>

  <style>
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .dashboard-header h1 {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-title);
    }

    .form-container {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 32px;
      box-shadow: var(--shadow-sm);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .form-group {
      margin-bottom: 24px;
    }

    .form-label {
      display: block;
      font-family: var(--font-heading);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-title);
      margin-bottom: 8px;
    }

    .form-input {
      width: 100%;
      padding: 12px 16px;
      font-family: var(--font-body);
      font-size: 0.95rem;
      color: var(--text-main);
      background-color: #FAFAFC;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      transition: var(--transition);
    }

    .form-input:focus {
      outline: none;
      background-color: #FFFFFF;
      border-color: var(--primary);
      box-shadow: 0 0 0 3.5px rgba(74, 21, 75, 0.12);
    }

    textarea.form-input {
      resize: vertical;
      min-height: 100px;
    }

    .form-actions {
      display: flex;
      gap: 16px;
      margin-top: 32px;
    }

    .alert {
      padding: 16px 20px;
      border-radius: var(--radius-md);
      margin-bottom: 24px;
      border-left: 4px solid;
    }

    .alert-danger {
      background: #FEF2F2;
      border-color: #DC2626;
      color: #991B1B;
    }

    @media (max-width: 768px) {
      .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</body>
</html>