<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Module Management | Pastors LMS' %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body class="app-container">
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="dashboard-header">
      <div>
        <h1>Manage Modules &amp; Lecturers</h1>
        <p class="course-subtitle"><%= course.title %> (<%= course.code %>)</p>
      </div>
      <div class="admin-actions">
        <a href="/admin/courses/<%= course.id %>" class="btn btn-secondary">Course Overview</a>
        <a href="/admin/courses" class="btn btn-outline">← Back to Courses</a>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success" role="status">
        <%= success %>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert">
        <%= error %>
      </div>
    <% } %>

    <!-- Default Course Lecturer (Super Admin Only) -->
    <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
      <form method="POST" action="/admin/courses/<%= course.id %>/instructor" class="lecturer-default-form" id="modulesDefaultLecturerForm">
        <input type="hidden" name="return_to" value="/admin/courses/<%= course.id %>/modules">
        <label for="modulesCourseInstructorSelect">Default Course Lecturer (<%= course.code %>):</label>
        <select name="instructor_username" id="modulesCourseInstructorSelect" class="lecturer-select">
          <option value="">-- No default lecturer --</option>
          <% (teachers || []).forEach(t => { %>
            <option value="<%= t.username %>" <%= (course.instructor_username && course.instructor_username.toLowerCase() === t.username.toLowerCase()) ? 'selected' : '' %>>
              <%= t.full_name %> (@<%= t.username %><%= t.phone ? ' • ' + t.phone : ' • No WhatsApp set' %>)
            </option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary btn-sm" id="btnSaveModulesCourseLecturer">Save Course Lecturer</button>
      </form>
    <% } else if (typeof courseInstructor !== 'undefined' && courseInstructor) { %>
      <div class="lecturer-default-form">
        <strong>Default Course Lecturer:</strong>
        <span><%= courseInstructor.full_name %></span>
        <span class="lecturer-subtitle">(Only Super Admin can change lecturer assignments)</span>
      </div>
    <% } %>

    <!-- Weekly Rhythm Schedule Auto-Generator -->
    <section class="weekly-schedule-card" id="weeklyScheduleCard">
      <div class="weekly-schedule-head">
        <div>
          <h3>Weekly Unit Release Schedule (Thu &rarr; Wed, EAT)</h3>
          <p class="lecturer-subtitle">Automatically assign weekly unlock dates (Thursday) and due dates (Wednesday) across all learning units in <strong><%= course.code %></strong>.</p>
        </div>
        <form action="/admin/courses/<%= course.id %>/modules/clear-schedule" method="POST">
          <button type="submit" class="btn btn-outline btn-sm" id="btnClearWeeklySchedule">Clear Schedule (Open All Units)</button>
        </form>
      </div>
      <form action="/admin/courses/<%= course.id %>/modules/generate-schedule" method="POST" class="extension-form-grid" id="generateScheduleForm">
        <div>
          <label class="form-label" for="scheduleTermSelect">Select Academic Term</label>
          <select id="scheduleTermSelect" name="term_id" class="form-input">
            <% (typeof terms !== 'undefined' ? terms : []).forEach(t => { %>
              <option value="<%= t.id %>" <%= (activeTerm && activeTerm.id === t.id) ? 'selected' : '' %>>
                <%= t.code %> (Starts <%= t.start_date %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="form-label" for="scheduleStartInput">Or Custom Start Date (Thursday)</label>
          <input type="date" id="scheduleStartInput" name="start_date" class="form-input">
        </div>
        <div class="extension-submit-wrap">
          <button type="submit" class="btn btn-primary" id="btnGenerateWeeklySchedule">Auto-Generate Weekly Unit Dates</button>
        </div>
      </form>
    </section>

    <!-- Add New Module Form -->
    <div class="form-container add-module-form">
      <h3>Add New Module</h3>
      <form action="/admin/courses/<%= course.id %>/modules/new" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="title">Module Title *</label>
            <input type="text" id="title" name="title" class="form-input" 
                   placeholder="e.g., Unit 1: What is the Gospel?" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="total_topics">Total Topics *</label>
            <input type="number" id="total_topics" name="total_topics" class="form-input" 
                   placeholder="e.g., 6" min="1" required>
          </div>

          <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
            <div class="form-group">
              <label class="form-label" for="newModuleInstructor">Module Lecturer (Optional)</label>
              <select id="newModuleInstructor" name="instructor_username" class="form-input">
                <option value="">Use Course Default<%= courseInstructor ? ' (' + courseInstructor.full_name + ')' : '' %></option>
                <% (teachers || []).forEach(t => { %>
                  <option value="<%= t.username %>"><%= t.full_name %> (@<%= t.username %>)</option>
                <% }) %>
              </select>
            </div>
          <% } %>
        </div>

        <button type="submit" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Module
        </button>
      </form>
    </div>

    <!-- Existing Modules -->
    <div class="modules-container">
      <h3>Current Modules (<%= modulesWithInstructors ? modulesWithInstructors.length : 0 %>)</h3>
      
      <% if (!modulesWithInstructors || modulesWithInstructors.length === 0) { %>
        <div class="empty-state">
          <p>No modules added yet. Use the form above to add your first module.</p>
        </div>
      <% } else { %>
        <div class="modules-list">
          <% modulesWithInstructors.forEach((module, index) => { %>
            <div class="module-card">
              <div class="module-header">
                <div class="module-number">Module <%= index + 1 %></div>
                <div class="module-actions">
                  <a href="/admin/courses/<%= course.id %>/modules/<%= module.id %>/lessons" class="btn btn-sm btn-primary" id="btnEditModLessons-<%= module.id %>">
                    Edit Lessons &amp; Quizzes
                  </a>
                  <form action="/admin/courses/<%= course.id %>/modules/<%= module.id %>/delete" method="POST" 
                        class="delete-form" onsubmit="return confirm('Are you sure you want to delete this module?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </div>
              </div>
              
              <div class="module-body">
                <h4 class="module-title"><%= module.title %></h4>
                <div class="module-stats">
                  <div class="stat-item">
                    <span class="stat-label">Total Topics:</span>
                    <span class="stat-value"><%= module.total_topics %></span>
                  </div>
                  <div class="stat-item">
                    <span class="stat-label">Opens:</span>
                    <span class="stat-value"><%= module.unlock_date || 'Open immediately' %></span>
                  </div>
                  <div class="stat-item">
                    <span class="stat-label">Due:</span>
                    <span class="stat-value"><%= module.due_date || 'No hard lock' %></span>
                  </div>
                  <div class="stat-item">
                    <span class="stat-label">Lecturer:</span>
                    <span class="stat-value">
                      <% if (module.resolvedInstructor) { %>
                        <%= module.resolvedInstructor.full_name %>
                        <span class="lecturer-scope-tag <%= module.hasOverride ? 'lecturer-scope-module' : 'lecturer-scope-course' %>">
                          <%= module.hasOverride ? 'Module Lecturer' : 'Course Default' %>
                        </span>
                      <% } else { %>
                        Unassigned
                      <% } %>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Assign Lecturer for this Module (Super Admin Only) -->
              <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
                <form action="/admin/courses/<%= course.id %>/modules/<%= module.id %>/instructor" method="POST" class="module-lecturer-form" id="modulesPageLecturerForm-<%= module.id %>">
                  <input type="hidden" name="return_to" value="/admin/courses/<%= course.id %>/modules">
                  <label class="form-label" for="modulesPageLecturerSelect-<%= module.id %>">Assign Lecturer:</label>
                  <select name="instructor_username" id="modulesPageLecturerSelect-<%= module.id %>" class="lecturer-select">
                    <option value="">Use Course Default<%= courseInstructor ? ' (' + courseInstructor.full_name + ')' : '' %></option>
                    <% (teachers || []).forEach(t => { %>
                      <option value="<%= t.username %>" <%= (module.instructor_username && module.instructor_username.toLowerCase() === t.username.toLowerCase()) ? 'selected' : '' %>>
                        <%= t.full_name %> (@<%= t.username %>)
                      </option>
                    <% }) %>
                  </select>
                  <button type="submit" class="btn btn-sm btn-primary" id="btnSaveModulesPageLecturer-<%= module.id %>">Save Lecturer</button>
                </form>
              <% } %>

              <!-- Quick Edit Form -->
              <form action="/admin/courses/<%= course.id %>/modules/<%= module.id %>/edit" method="POST" class="quick-edit-form">
                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label">Edit Title:</label>
                    <input type="text" name="title" class="form-input" value="<%= module.title %>">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Edit Topics:</label>
                    <input type="number" name="total_topics" class="form-input" value="<%= module.total_topics %>" min="1">
                  </div>
                </div>
                <button type="submit" class="btn btn-sm btn-outline">Update Module</button>
              </form>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="admin-nav-links">
      <a href="/admin/courses/<%= course.id %>/edit" class="btn btn-outline">Edit Course Details</a>
      <a href="/" class="btn btn-outline">Return to Dashboard</a>
    </div>
  </main>

  <style>
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .dashboard-header h1 {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-title);
    }

    .course-subtitle {
      margin: 4px 0 0 0;
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .form-container {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
    }

    .add-module-form h3 {
      margin: 0 0 20px 0;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-title);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-family: var(--font-heading);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-title);
      margin-bottom: 6px;
    }

    .form-input {
      width: 100%;
      padding: 10px 14px;
      font-family: var(--font-body);
      font-size: 0.9rem;
      color: var(--text-main);
      background-color: #F7F9FB;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      transition: var(--transition);
    }

    .form-input:focus {
      outline: none;
      background-color: #FFFFFF;
      border-color: var(--primary);
      box-shadow: 0 0 0 3.5px rgba(25, 47, 71, 0.12);
    }

    .modules-container {
      margin-bottom: 24px;
    }

    .modules-container h3 {
      margin: 0 0 20px 0;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text-title);
    }

    .empty-state {
      background: var(--bg-app);
      border: 2px dashed var(--border);
      border-radius: var(--radius-md);
      padding: 40px;
      text-align: center;
      color: var(--text-muted);
    }

    .modules-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .module-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }

    .module-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .module-number {
      font-family: var(--font-heading);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .module-actions {
      display: flex;
      gap: 8px;
    }

    .delete-form {
      display: inline;
    }

    .module-body {
      margin-bottom: 16px;
    }

    .module-title {
      margin: 0 0 12px 0;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-title);
    }

    .module-stats {
      display: flex;
      gap: 24px;
      font-size: 0.85rem;
    }

    .stat-item {
      display: flex;
      gap: 6px;
    }

    .stat-label {
      color: var(--text-muted);
      font-weight: 500;
    }

    .stat-value {
      color: var(--text-title);
      font-weight: 600;
    }

    .quick-edit-form {
      padding-top: 16px;
      border-top: 1px solid var(--border-light);
    }

    .quick-edit-form .form-row {
      margin-bottom: 12px;
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 0.85rem;
    }

    .btn-danger {
      background: rgba(235, 60, 80, 0.1);
      color: #EB3C50;
      border: 1px solid rgba(235, 60, 80, 0.3);
    }

    .btn-danger:hover {
      background: rgba(235, 60, 80, 0.2);
      border-color: #EB3C50;
    }

    .admin-nav-links {
      display: flex;
      gap: 16px;
    }

    .alert {
      padding: 16px 20px;
      border-radius: var(--radius-md);
      margin-bottom: 24px;
      border-left: 4px solid;
    }

    .alert-danger {
      background: #FEF2F2;
      border-color: #DC2626;
      color: #991B1B;
    }

    @media (max-width: 768px) {
      .form-row {
        grid-template-columns: 1fr;
      }
      
      .module-stats {
        flex-direction: column;
        gap: 8px;
      }
    }
  </style>
  <%- include('../partials/footer') %>
</body>
</html>