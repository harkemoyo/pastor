<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body class="app-container">
  <%- include('../partials/header') %>
  <main class="admin-page">
    <div class="admin-topbar">
      <div>
        <h1 class="admin-title">Student Details</h1>
        <div class="admin-subtitle"><%= student.full_name || [student.first_name, student.last_name].filter(Boolean).join(' ') %></div>
      </div>
      <div class="admin-actions">
        <a href="/admin/students/<%= student.student_id || student.username %>/transcript" class="btn btn-primary" id="btnAdminViewTranscript">Official Transcript</a>
        <a href="/admin/students" class="btn btn-secondary">Back to Students</a>
      </div>
    </div>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <section class="admin-surface">
      <div class="detail-grid">
        <div class="info-card">
          <h3>Personal Information</h3>
          <div class="meta-list">
            <div class="meta-row"><strong>Student ID</strong><span><%= student.student_id || 'N/A' %></span></div>
            <div class="meta-row"><strong>Name</strong><span><%= student.full_name || [student.first_name, student.last_name].filter(Boolean).join(' ') %></span></div>
            <div class="meta-row"><strong>Email</strong><span><%= student.email %></span></div>
            <div class="meta-row"><strong>Phone</strong><span><%= student.phone || 'N/A' %></span></div>
            <div class="meta-row"><strong>Username</strong><span>@<%= student.username || 'N/A' %></span></div>
            <div class="meta-row"><strong>Account Role</strong><span><span class="badge"><%= (student.role || 'student').toUpperCase() %></span></span></div>
            <div class="meta-row"><strong>Status</strong><span><span class="badge status-<%= student.status || 'active' %>"><%= (student.status || 'active').charAt(0).toUpperCase() + (student.status || 'active').slice(1) %></span></span></div>
            <div class="meta-row"><strong>County</strong><span><%= student.county || 'N/A' %></span></div>
            <div class="meta-row"><strong>Town</strong><span><%= student.town || 'N/A' %></span></div>
            <div class="meta-row"><strong>Address</strong><span><%= student.physical_address || student.address || 'N/A' %></span></div>
            <div class="meta-row"><strong>Church / Ministry</strong><span><%= student.church_name || 'N/A' %></span></div>
            <div class="meta-row"><strong>Ministry Role</strong><span><%= student.ministry_role || 'N/A' %></span></div>
          </div>

          <div class="action-stack">
            <% const isSuperAdmin = locals.user && locals.user.role === 'super_admin'; %>
            <% const detailKey = student.username || student.student_id; %>
            <form method="POST" action="/admin/students/<%= detailKey %>/role" style="display:inline;">
              <select name="role" style="padding:0.6rem; border-radius:8px; border:1px solid #d1d5db; margin-right:0.5rem;">
                <option value="student" <%= (student.role || 'student') === 'student' ? 'selected' : '' %>>🎓 Student</option>
                <option value="teacher" <%= student.role === 'teacher' ? 'selected' : '' %>>📖 Teacher</option>
                <% if (isSuperAdmin) { %>
                  <option value="admin" <%= student.role === 'admin' ? 'selected' : '' %>>🛡️ Admin</option>
                  <option value="super_admin" <%= student.role === 'super_admin' ? 'selected' : '' %>>👑 Super Admin</option>
                <% } %>
              </select>
              <button type="submit" class="btn btn-primary btn-sm">Update Role</button>
            </form>
            <form method="POST" action="/admin/students/<%= detailKey %>/status" style="display:inline;">
              <select name="status" style="padding:0.6rem; border-radius:8px; border:1px solid #d1d5db; margin-right:0.5rem;">
                <option value="active" <%= student.status === 'active' ? 'selected' : '' %>>Active</option>
                <option value="inactive" <%= student.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                <option value="suspended" <%= student.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                <option value="graduated" <%= student.status === 'graduated' ? 'selected' : '' %>>Graduated</option>
              </select>
              <button type="submit" class="btn btn-primary btn-sm">Update Status</button>
            </form>
            <form method="POST" action="/admin/students/<%= detailKey %>/reset-password" style="display:inline;">
              <input type="hidden" name="new_password" value="Pastor@2026">
              <button type="submit" class="btn btn-warning btn-sm">Reset Password</button>
            </form>
            <form method="POST" action="/admin/students/<%= detailKey %>/archive" style="display:inline;">
              <button type="submit" class="btn btn-danger btn-sm">Archive Student</button>
            </form>
          </div>
        </div>

        <div class="info-card">
          <h3>Student Enrolments</h3>
          <% if (enrolments.length) { %>
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead><tr><th>Course</th><th>Code</th><th>Action</th></tr></thead>
                <tbody>
                  <% enrolments.forEach(item => { %>
                    <tr>
                      <td><%= item.course_name %></td>
                      <td><span class="badge course-badge"><%= item.course_code %></span></td>
                      <td>
                        <div class="action-row-inline">
                          <a href="/admin/students/<%= encodeURIComponent(student.student_id || student.username) %>/transcript?courseId=<%= item.course_id %>"
                             class="btn btn-secondary btn-sm"
                             id="btnCourseTx-<%= item.course_id %>">
                            Course Transcript
                          </a>
                          <form method="POST" action="/admin/students/<%= student.student_id %>/courses/<%= item.course_id %>/remove">
                            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">No courses enrolled yet.</div>
          <% } %>

          <form method="POST" action="/admin/students/<%= student.student_id %>/courses" class="filters-bar" style="margin-top:1rem;">
            <div class="filter-group" style="flex:1; min-width:220px;">
              <label>Add Course</label>
              <select name="course_id" required>
                <option value="">Select course</option>
                <% courses.forEach(course => { %>
                  <option value="<%= course.id %>"><%= course.title %> (<%= course.code %>)</option>
                <% }) %>
              </select>
            </div>
            <div class="filter-group">
              <button type="submit" class="btn btn-primary">Add Course</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Phase 4: Academic Program Track, Standing & Pastoral Mentor -->
    <% const detailSlug = student.username || student.student_id; %>
    <section class="admin-surface admin-section-spaced" id="studentAcademicsSection">
      <div class="lecturer-header-row">
        <div>
          <h3>Academic Program, Standing &amp; Pastoral Mentor</h3>
          <p class="lecturer-subtitle">Assign a Seminary program track and a dedicated Pastoral Mentor for academic &amp; spiritual guidance.</p>
        </div>
        <% if (typeof standing !== 'undefined' && standing) { %>
          <span class="standing-pill <%= standing.badgeClass %>" id="adminStudentStandingBadge">
            <%= standing.label %><% if (standing.gpa) { %> &bull; GPA <%= standing.gpa %><% } %>
          </span>
        <% } %>
      </div>

      <form method="POST" action="/admin/students/<%= detailSlug %>/academics" class="extension-form-grid" id="studentAcademicsForm">
        <div>
          <label class="form-label" for="studentProgramSelect">Program Track</label>
          <select id="studentProgramSelect" name="program_id" class="form-input">
            <% (typeof programs !== 'undefined' ? programs : []).forEach(p => { %>
              <option value="<%= p.id %>" <%= (typeof academicProfile !== 'undefined' && academicProfile && academicProfile.program_id === p.id) ? 'selected' : '' %>>
                <%= p.name %> (<%= p.id %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="form-label" for="studentMentorSelect">Assigned Pastoral Mentor</label>
          <select id="studentMentorSelect" name="mentor_username" class="form-input">
            <option value="">-- IDA Cohort Mentor Team --</option>
            <% (typeof mentors !== 'undefined' ? mentors : []).forEach(m => { %>
              <option value="<%= m.username %>" <%= (typeof academicProfile !== 'undefined' && academicProfile && academicProfile.mentor_username === String(m.username).toLowerCase()) ? 'selected' : '' %>>
                <%= m.full_name || m.username %> (<%= m.role.toUpperCase() %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="extension-submit-wrap">
          <button type="submit" class="btn btn-primary" id="btnSaveStudentAcademics">Save Program &amp; Mentor</button>
        </div>
      </form>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
