<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body class="app-container">
  <%- include('../partials/header') %>
  <main class="admin-page">
    <div class="admin-topbar">
      <div>
        <h1 class="admin-title">Course Details</h1>
        <div class="admin-subtitle"><%= course.title %> / <%= course.code %></div>
      </div>
      <div class="admin-actions">
        <a href="/admin/courses" class="btn btn-secondary">Back to Courses</a>
      </div>
    </div>

    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <section class="admin-surface">
      <div class="detail-grid">
        <div class="info-card">
          <h3>Course Information</h3>
          <div class="meta-list">
            <div class="meta-row"><strong>Course Name</strong><span><%= course.title %></span></div>
            <div class="meta-row"><strong>Course Code</strong><span><%= course.code %></span></div>
            <div class="meta-row"><strong>Status</strong><span><span class="badge status-<%= course.status || 'active' %>"><%= (course.status || 'active').charAt(0).toUpperCase() + ((course.status || 'active').slice(1)) %></span></span></div>
            <div class="meta-row"><strong>Instructor</strong><span><%= courseInstructor ? courseInstructor.full_name : (course.instructor || 'Unassigned') %></span></div>
            <div class="meta-row"><strong>Capacity</strong><span><%= course.capacity || 'Not limited' %></span></div>
            <div class="meta-row"><strong>Created</strong><span><%= course.created_at ? new Date(course.created_at).toLocaleDateString() : 'N/A' %></span></div>
          </div>

          <div class="action-stack">
            <a href="/admin/courses/<%= course.id %>/edit" class="btn btn-primary btn-sm">Edit Course</a>
            <% if ((course.status || 'active') === 'archived') { %>
              <form method="POST" action="/admin/courses/<%= course.id %>/restore" style="display:inline;">
                <button type="submit" class="btn btn-success btn-sm">Restore</button>
              </form>
            <% } else { %>
              <form method="POST" action="/admin/courses/<%= course.id %>/archive" style="display:inline;">
                <button type="submit" class="btn btn-warning btn-sm">Archive</button>
              </form>
            <% } %>
            <form method="POST" action="/admin/courses/<%= course.id %>/delete" style="display:inline;">
              <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete this course? If students are enrolled, it will be archived instead.')">Delete</button>
            </form>
          </div>
        </div>

        <div class="info-card">
          <h3>Description</h3>
          <p><%= course.description || 'No description provided.' %></p>
        </div>
      </div>
    </section>

    <section class="admin-surface admin-section-spaced" id="courseLecturersSection">
      <div class="lecturer-header-row">
        <div>
          <h3>Course &amp; Module Lecturers</h3>
          <p class="lecturer-subtitle">
            Assign a default lecturer for <strong><%= course.code %></strong>, or assign a dedicated lecturer to individual modules. Students will see their assigned lecturer's WhatsApp &amp; Email directly inside each module.
          </p>
        </div>
        <% if (isSuperAdmin) { %>
          <a href="/admin/students" class="btn btn-secondary btn-sm" id="btnManageTeacherAccounts">Manage Teacher Accounts</a>
        <% } %>
      </div>

      <% if (isSuperAdmin) { %>
        <form method="POST" action="/admin/courses/<%= course.id %>/instructor" class="lecturer-default-form" id="courseDefaultLecturerForm">
          <label for="courseInstructorSelect">Default Course Lecturer (<%= course.code %>):</label>
          <select name="instructor_username" id="courseInstructorSelect" class="lecturer-select">
            <option value="">-- No default lecturer --</option>
            <% (teachers || []).forEach(t => { %>
              <option value="<%= t.username %>" <%= (course.instructor_username && course.instructor_username.toLowerCase() === t.username.toLowerCase()) ? 'selected' : '' %>>
                <%= t.full_name %> (@<%= t.username %><%= t.phone ? ' • ' + t.phone : ' • No WhatsApp set' %>)
              </option>
            <% }) %>
          </select>
          <button type="submit" class="btn btn-primary btn-sm" id="btnSaveCourseLecturer">Save Course Lecturer</button>
        </form>
      <% } else { %>
        <div class="lecturer-default-form">
          <strong>Default Course Lecturer:</strong>
          <span><%= courseInstructor ? courseInstructor.full_name : 'Unassigned' %></span>
          <span class="lecturer-subtitle">(Only Super Admin can change lecturer assignments)</span>
        </div>
      <% } %>

      <% if (modulesWithInstructors && modulesWithInstructors.length) { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Module / Unit</th>
                <th>Assigned Lecturer</th>
                <% if (isSuperAdmin) { %><th>Assign Lecturer for Module</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% modulesWithInstructors.forEach(mod => { %>
                <tr>
                  <td><strong><%= mod.title %></strong></td>
                  <td>
                    <% if (mod.resolvedInstructor) { %>
                      <strong><%= mod.resolvedInstructor.full_name %></strong>
                      <span class="lecturer-scope-tag <%= mod.hasOverride ? 'lecturer-scope-module' : 'lecturer-scope-course' %>">
                        <%= mod.hasOverride ? 'Module Lecturer' : 'Course Default' %>
                      </span>
                      <span class="lecturer-contact-meta">
                        <%= mod.resolvedInstructor.email || 'No email' %>
                        <% if (mod.resolvedInstructor.phone) { %> &middot; WhatsApp: <%= mod.resolvedInstructor.phone %><% } %>
                      </span>
                    <% } else { %>
                      <span class="lecturer-subtitle">Unassigned</span>
                    <% } %>
                  </td>
                  <% if (isSuperAdmin) { %>
                    <td>
                      <form method="POST" action="/admin/courses/<%= course.id %>/modules/<%= mod.id %>/instructor" class="module-lecturer-form" id="modLecturerForm-<%= mod.id %>">
                        <select name="instructor_username" id="modLecturerSelect-<%= mod.id %>" class="lecturer-select" aria-label="Lecturer for <%= mod.title %>">
                          <option value="">Use Course Default<%= courseInstructor ? ' (' + courseInstructor.full_name + ')' : '' %></option>
                          <% (teachers || []).forEach(t => { %>
                            <option value="<%= t.username %>" <%= (mod.instructor_username && mod.instructor_username.toLowerCase() === t.username.toLowerCase()) ? 'selected' : '' %>>
                              <%= t.full_name %> (@<%= t.username %>)
                            </option>
                          <% }) %>
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm" id="btnSaveModLecturer-<%= mod.id %>">Save</button>
                      </form>
                    </td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">No modules configured for this course yet.</div>
      <% } %>
    </section>

    <section class="admin-surface admin-section-spaced">
      <h3>Enrolled Students</h3>
      <% if (enrolments.length) { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead><tr><th>Student</th><th>Email</th><th>Status</th></tr></thead>
            <tbody>
              <% enrolments.forEach(item => { %>
                <tr>
                  <td><%= item.student_name %></td>
                  <td><%= item.student_email %></td>
                  <td><span class="badge status-<%= item.status || 'active' %>"><%= (item.status || 'active').charAt(0).toUpperCase() + ((item.status || 'active').slice(1)) %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">No students are enrolled in this course.</div>
      <% } %>
    </section>

    <!-- Course Prerequisite (Phase 4) -->
    <section class="admin-surface admin-section-spaced" id="coursePrereqSection">
      <h3>Course Prerequisite</h3>
      <p class="lecturer-subtitle">Require students to pass or complete a foundation course before registering for <strong><%= course.code %></strong>.</p>
      <form method="POST" action="/admin/courses/<%= course.id %>/prerequisite" class="prereq-form-row" id="coursePrereqForm">
        <label class="form-label" for="coursePrereqSelect">Required Foundation Course:</label>
        <select id="coursePrereqSelect" name="prerequisite_code" class="lecturer-select">
          <option value="">None (Open to all students)</option>
          <% (typeof allCourses !== 'undefined' ? allCourses : []).filter(c => Number(c.id) !== Number(course.id)).forEach(c => { %>
            <option value="<%= c.code %>" <%= (course.prerequisite_code && course.prerequisite_code.toUpperCase() === c.code.toUpperCase()) ? 'selected' : '' %>>
              <%= c.code %> — <%= c.title %>
            </option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary btn-sm" id="btnSaveCoursePrereq">Save Prerequisite</button>
      </form>
    </section>

    <!-- Per-Course Syllabus Grade Weights (Phase 3) -->
    <section class="admin-surface admin-section-spaced" id="courseWeightsSection">
      <h3>Syllabus Grade Category Weights</h3>
      <p class="lecturer-subtitle">Set custom category weights for <strong><%= course.code %></strong> (must sum to <strong>100%</strong>). Practice Self-Quizzes remain ungraded.</p>
      <% const w = (typeof courseWeights !== 'undefined' && courseWeights) ? courseWeights : { assignment: 25, journal: 15, discussion: 20, quiz: 15, exam: 25 }; %>
      <form method="POST" action="/admin/courses/<%= course.id %>/weights" class="weights-form-grid" id="courseWeightsForm">
        <div>
          <label class="form-label" for="weightAssignInput">Written Assignments (%)</label>
          <input type="number" id="weightAssignInput" name="weight_assignment" class="form-input" min="0" max="100" value="<%= w.assignment %>" required>
        </div>
        <div>
          <label class="form-label" for="weightJournalInput">Ministry Journals (%)</label>
          <input type="number" id="weightJournalInput" name="weight_journal" class="form-input" min="0" max="100" value="<%= w.journal %>" required>
        </div>
        <div>
          <label class="form-label" for="weightDiscussionInput">Cohort Discussions (%)</label>
          <input type="number" id="weightDiscussionInput" name="weight_discussion" class="form-input" min="0" max="100" value="<%= w.discussion %>" required>
        </div>
        <div>
          <label class="form-label" for="weightQuizInput">Graded Quizzes (%)</label>
          <input type="number" id="weightQuizInput" name="weight_quiz" class="form-input" min="0" max="100" value="<%= w.quiz %>" required>
        </div>
        <div>
          <label class="form-label" for="weightExamInput">Final Exam (%)</label>
          <input type="number" id="weightExamInput" name="weight_exam" class="form-input" min="0" max="100" value="<%= w.exam %>" required>
        </div>
        <div class="extension-submit-wrap">
          <button type="submit" class="btn btn-primary" id="btnSaveCourseWeights">Save Grade Weights</button>
        </div>
      </form>
    </section>

    <!-- Anonymous End-of-Course Evaluation Summary -->
    <section class="admin-surface admin-section-spaced" id="courseEvalSummarySection">
      <h3>Anonymous Course Evaluation Summary</h3>
      <% const ev = typeof evaluationSummary !== 'undefined' ? evaluationSummary : { totalResponses: 0 }; %>
      <% if (!ev || ev.totalResponses === 0) { %>
        <div class="empty-state">No anonymous course evaluations submitted yet for <%= course.code %>.</div>
      <% } else { %>
        <p class="lecturer-subtitle">Aggregated across <strong><%= ev.totalResponses %></strong> anonymous pastoral response(s).</p>
        <div class="eval-stats-grid">
          <div class="info-card"><strong>Overall Rating</strong><div><%= ev.avgOverall %> / 5.0</div></div>
          <div class="info-card"><strong>Biblical Content</strong><div><%= ev.avgContent %> / 5.0</div></div>
          <div class="info-card"><strong>Instructor Care</strong><div><%= ev.avgInstructor %> / 5.0</div></div>
          <div class="info-card"><strong>Lesson Clarity</strong><div><%= ev.avgClarity %> / 5.0</div></div>
          <div class="info-card"><strong>Ministry Impact</strong><div><%= ev.avgMinistryImpact %> / 5.0</div></div>
        </div>
        <% if (ev.comments && ev.comments.length) { %>
          <div class="eval-comments-list">
            <% ev.comments.forEach(c => { %>
              <blockquote class="eval-comment-card">
                <p><%= c.text %></p>
                <span>Rating: <%= c.overall_rating %>/5 &bull; <%= new Date(c.submitted_at).toLocaleDateString() %></span>
              </blockquote>
            <% }) %>
          </div>
        <% } %>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
