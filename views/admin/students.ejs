<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body class="app-container">
  <%- include('../partials/header') %>
  <main class="admin-page">
    <div class="admin-topbar">
      <div>
        <h1 class="admin-title">Students</h1>
        <div class="admin-subtitle">View, search, filter, and manage all ministry students</div>
      </div>
      <div class="admin-actions" style="display: flex; gap: 8px;">
        <button type="button" class="btn btn-secondary" onclick="window.print()" title="Print student roster for physical meetings">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 4px;">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          Print Roster
        </button>
        <a href="/admin/students/new" class="btn btn-primary">+ Add Student</a>
      </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div style="background: #e7f6ec; color: #14532d; border: 1.5px solid #86efac; padding: 12px 16px; border-radius: 8px; margin-bottom: 1rem; font-weight: 600;">
        <%= success %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: #fdecee; color: #7f1d1d; border: 1.5px solid #fca5a5; padding: 12px 16px; border-radius: 8px; margin-bottom: 1rem; font-weight: 600;">
        <%= error %>
      </div>
    <% } %>

    <section class="admin-surface">
      <!-- Quick Status Filter Tabs -->
      <div class="status-pill-list">
        <a href="/admin/students?status=all" class="status-pill <%= (!filters.status || filters.status === 'all') ? 'active' : '' %>">
          All <span class="pill-count"><%= (typeof statusCounts !== 'undefined' && statusCounts) ? statusCounts.all : students.length %></span>
        </a>
        <a href="/admin/students?status=active" class="status-pill <%= filters.status === 'active' ? 'active' : '' %>">
          Active <span class="pill-count"><%= (typeof statusCounts !== 'undefined' && statusCounts) ? statusCounts.active : 0 %></span>
        </a>
        <a href="/admin/students?status=pending" class="status-pill <%= filters.status === 'pending' ? 'active' : '' %>">
          Pending Approval <span class="pill-count"><%= (typeof statusCounts !== 'undefined' && statusCounts) ? statusCounts.pending : 0 %></span>
        </a>
        <a href="/admin/students?status=inactive" class="status-pill <%= filters.status === 'inactive' ? 'active' : '' %>">
          Inactive / Suspended <span class="pill-count"><%= (typeof statusCounts !== 'undefined' && statusCounts) ? statusCounts.inactive : 0 %></span>
        </a>
      </div>

      <form method="GET" action="/admin/students" class="filters-bar" id="studentFilterForm">
        <div class="filter-group" style="flex: 2; min-width: 220px;">
          <label>Search</label>
          <input type="text" id="adminStudentSearch" name="search" value="<%= filters.search %>" placeholder="Type name, phone, church, town..." autocomplete="off" />
        </div>
        <div class="filter-group">
          <label>Status</label>
          <select name="status" onchange="document.getElementById('studentFilterForm').submit()">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
            <option value="graduated" <%= filters.status === 'graduated' ? 'selected' : '' %>>Graduated</option>
          </select>
        </div>
        <div class="filter-group">
          <label>Course</label>
          <select name="course_id" onchange="document.getElementById('studentFilterForm').submit()">
            <option value="" <%= !filters.course_id ? 'selected' : '' %>>All courses</option>
            <% courses.forEach(course => { %>
              <option value="<%= course.id %>" <%= String(filters.course_id) === String(course.id) ? 'selected' : '' %>><%= course.title %></option>
            <% }) %>
          </select>
        </div>
        <div class="filter-group">
          <button type="submit" class="btn btn-primary">Filter</button>
        </div>
      </form>

      <% if (students.length) { %>
        <div class="admin-table-wrap">
          <table class="admin-table" id="adminStudentsTable">
            <thead>
              <tr>
                <th>Student ID</th>
                <th>Pastor / Learner</th>
                <th>Contact</th>
                <th>Status</th>
                <th>Courses</th>
                <th>Registered</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(student => { %>
                <tr class="student-row">
                  <td><strong><%= student.student_id || 'N/A' %></strong></td>
                  <td>
                    <div style="font-weight: 700; font-size: 0.95rem;"><%= student.full_name || [student.first_name, student.last_name].filter(Boolean).join(' ') %></div>
                    <% if (student.church_name || student.town || student.county) { %>
                      <small style="color: #6b7280; font-size: 0.8rem; display: block; margin-top: 2px;">
                        🏛️ <%= [student.church_name, [student.town, student.county].filter(Boolean).join(', ')].filter(Boolean).join(' • ') %>
                      </small>
                    <% } %>
                  </td>
                  <td>
                    <div style="font-size: 0.88rem;"><%= student.email %></div>
                    <% if (student.phone) { %>
                      <% const rawDigits = String(student.phone).replace(/\D/g, ''); %>
                      <div style="margin-top: 3px; font-size: 0.82rem; display: flex; align-items: center; gap: 6px;">
                        <a href="tel:<%= student.phone %>" style="color: #4b5563; text-decoration: none;">📞 <%= student.phone %></a>
                        <% if (rawDigits) { %>
                          <a href="https://wa.me/<%= rawDigits.startsWith('0') ? '254' + rawDigits.slice(1) : rawDigits %>" target="_blank" rel="noopener noreferrer" title="Chat on WhatsApp" style="color: #16a34a; font-weight: 600; text-decoration: none;">💬 WhatsApp</a>
                        <% } %>
                      </div>
                    <% } else { %>
                      <small style="color: #9ca3af;">No phone</small>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge status-<%= student.status || 'active' %>"><%= (student.status || 'active').charAt(0).toUpperCase() + (student.status || 'active').slice(1) %></span>
                  </td>
                  <td><%= (student.student_id ? (student.enrolled_courses || 0) : 0) || 0 %></td>
                  <td><%= student.created_at ? new Date(student.created_at).toLocaleDateString() : 'N/A' %></td>
                  <td>
                    <div class="action-stack" style="display: flex; gap: 6px; flex-wrap: wrap;">
                      <% if (student.status === 'pending' || student.approval_status === 'pending') { %>
                        <form method="POST" action="/admin/students/<%= student.student_id || student.username %>/approve" style="display: inline;">
                          <input type="hidden" name="redirect_to" value="/admin/students">
                          <button type="submit" class="btn btn-sm btn-success" style="background: #166534; color: white; border: none; padding: 4px 8px; border-radius: 4px; font-weight: 600; cursor: pointer;">
                            ✓ Approve
                          </button>
                        </form>
                      <% } %>
                      <a href="/admin/students/<%= student.student_id || student.username %>" class="btn btn-sm btn-secondary">View</a>
                      <a href="/admin/students/<%= student.student_id || student.username %>/edit" class="btn btn-sm btn-secondary">Edit</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="pagination">
          <div>Showing <%= pagination.totalItems ? ((pagination.page - 1) * pagination.pageSize) + 1 : 0 %> - <%= Math.min(pagination.page * pagination.pageSize, pagination.totalItems) %> of <%= pagination.totalItems %> students</div>
          <div class="pagination-links">
            <% if (pagination.page > 1) { %>
              <a href="/admin/students?search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>&course_id=<%= filters.course_id %>&page=<%= pagination.page - 1 %>">Prev</a>
            <% } %>
            <% for (let i = 1; i <= pagination.totalPages; i++) { %>
              <% if (i === pagination.page) { %>
                <span class="current"><%= i %></span>
              <% } else { %>
                <a href="/admin/students?search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>&course_id=<%= filters.course_id %>&page=<%= i %>"><%= i %></a>
              <% } %>
            <% } %>
            <% if (pagination.page < pagination.totalPages) { %>
              <a href="/admin/students?search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>&course_id=<%= filters.course_id %>&page=<%= pagination.page + 1 %>">Next</a>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <div class="empty-state">No students match the current search or filters.</div>
      <% } %>
    </section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
