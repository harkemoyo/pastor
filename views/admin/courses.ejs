<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Course Management | Pastors LMS' %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body class="app-container">
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="dashboard-header">
      <h1>Course Management</h1>
      <a href="/admin/courses/new" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Create New Course
      </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert">
        <%= error %>
      </div>
    <% } %>

    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Course Code</th>
            <th>Title</th>
            <th>Term</th>
            <th>Status</th>
            <th>Modules</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% courses.forEach(course => { %>
            <tr>
              <td><strong><%= course.code %></strong></td>
              <td><%= course.title %></td>
              <td><%= course.term %></td>
              <td>
                <span class="status-badge <%= course.status %>">
                  <%= course.status.charAt(0).toUpperCase() + course.status.slice(1) %>
                </span>
              </td>
              <td><%= course.modules ? course.modules.length : 0 %> modules</td>
              <td class="action-buttons">
                <a href="/admin/courses/<%= course.id %>/modules" class="btn btn-sm btn-outline" title="Manage Modules">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
                    <path d="M6 6h10"/>
                    <path d="M6 10h10"/>
                  </svg>
                  Modules
                </a>
                <a href="/admin/courses/<%= course.id %>/edit" class="btn btn-sm btn-outline" title="Edit Course">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                  </svg>
                  Edit
                </a>
                <form action="/admin/courses/<%= course.id %>/delete" method="POST" class="delete-form" onsubmit="return confirm('Are you sure you want to delete this course? This action cannot be undone.');">
                  <button type="submit" class="btn btn-sm btn-danger" title="Delete Course">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="3 6 5 6 21 6"/>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    </svg>
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="admin-nav-links">
      <a href="/admin/users" class="btn btn-outline">← Back to User Management</a>
      <a href="/" class="btn btn-outline">Return to Dashboard</a>
    </div>
  </main>

  <style>
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .dashboard-header h1 {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-title);
    }

    .admin-table-container {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .admin-table {
      width: 100%;
      border-collapse: collapse;
    }

    .admin-table thead {
      background: var(--bg-app);
    }

    .admin-table th {
      padding: 16px;
      text-align: left;
      font-weight: 600;
      color: var(--text-title);
      border-bottom: 2px solid var(--border);
    }

    .admin-table td {
      padding: 16px;
      border-bottom: 1px solid var(--border-light);
    }

    .admin-table tr:last-child td {
      border-bottom: none;
    }

    .admin-table tr:hover {
      background: var(--bg-app);
    }

    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .status-badge.current {
      background: var(--success-bg);
      color: var(--success);
    }

    .status-badge.past {
      background: var(--bg-app);
      color: var(--text-muted);
    }

    .action-buttons {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .delete-form {
      display: inline;
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 0.85rem;
    }

    .btn-danger {
      background: rgba(235, 60, 80, 0.1);
      color: #EB3C50;
      border: 1px solid rgba(235, 60, 80, 0.3);
    }

    .btn-danger:hover {
      background: rgba(235, 60, 80, 0.2);
      border-color: #EB3C50;
    }

    .admin-nav-links {
      display: flex;
      gap: 16px;
      margin-top: 30px;
    }

    .alert {
      padding: 16px 20px;
      border-radius: var(--radius-md);
      margin-bottom: 24px;
      border-left: 4px solid;
    }

    .alert-danger {
      background: #FEF2F2;
      border-color: #DC2626;
      color: #991B1B;
    }
  </style>
</body>
</html>