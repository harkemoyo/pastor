<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Offline Reading | Pastors LMS' %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body class="app-container">
  <%- include('partials/header') %>

  <main class="main-content">
    <section class="offline-card">
      <h1>You Are Currently Offline</h1>
      <p>Your phone or computer does not have an internet connection right now. Do not worry &mdash; you can still read any course lessons you opened earlier or saved for offline reading.</p>
      <div class="offline-actions">
        <a href="/courses" class="btn btn-primary" id="btnOfflineCourses">Open Saved Courses</a>
        <button type="button" class="btn btn-secondary" id="btnOfflineRetry" onclick="window.location.reload()">Try Again</button>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
