<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= course.code %> - <%= course.title %> | Pastors LMS</title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/course.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#192F47">
</head>

<body class="bp-lms-body">

  <!-- =========================================================================
       1. BRIGHTSPACE TOP NAVBAR (University Logo, Course Code, Global Tools)
       ========================================================================= -->
  <header class="bp-top-bar">
    <div class="bp-top-left">
      <a href="/" class="bp-brand" title="Return to Dashboard">
        <img src="/images/IDA-Logo-Complete.webp" alt="Pastors LMS - Intentional Discipleship Africa" class="bp-logo" width="93" height="72">
      </a>
      <div class="bp-top-divider"></div>
      <div class="bp-course-identity">
        <span class="bp-course-code"><%= course.code %>-01 - <%= course.term || 'AY2027-T1' %></span>
      </div>
    </div>

    <div class="bp-top-right">
      <!-- 9-dot Waffle / Course Launcher -->
      <button class="bp-icon-btn" id="bpCourseLauncherBtn" title="Select Course / Course Selector" aria-label="Course Selector">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="4" height="4" rx="1" />
          <rect x="10" y="3" width="4" height="4" rx="1" />
          <rect x="17" y="3" width="4" height="4" rx="1" />
          <rect x="3" y="10" width="4" height="4" rx="1" />
          <rect x="10" y="10" width="4" height="4" rx="1" />
          <rect x="17" y="10" width="4" height="4" rx="1" />
          <rect x="3" y="17" width="4" height="4" rx="1" />
          <rect x="10" y="17" width="4" height="4" rx="1" />
          <rect x="17" y="17" width="4" height="4" rx="1" />
        </svg>
      </button>

      <div class="bp-icon-divider"></div>

      <!-- Messages / Mail -->
      <a href="#messages" class="bp-icon-btn" title="Internal Pastoral Email & Messages" onclick="alert('Pastoral Messages & Cohort Inquiries: You have no unread messages from your faculty mentor.')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
      </a>

      <!-- Cohort Discussions Bubble -->
      <a href="#chat" class="bp-icon-btn" title="Instant Cohort Exchange" onclick="alert('Discussion Forum: 4 active discussions in this module.')">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
        </svg>
      </a>

      <!-- Notifications Bell with Orange Dot Badge -->
      <div class="bp-bell-wrapper">
        <button class="bp-icon-btn" id="bpNotificationsBtn" title="Course Alerts & Updates" onclick="alert('Updates: Unit 1 Self-Quiz is due on Oct 15, 2026.')">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
          </svg>
          <span class="bp-notification-dot"></span>
        </button>
      </div>

      <!-- User Profile Avatar Pill -->
      <div class="bp-user-pill" title="Logged in as <%= locals.user ? locals.user.full_name : 'Pastor' %>">
        <div class="bp-avatar">
          <%= locals.user ? (locals.user.initials || 'HE') : 'HE' %>
        </div>
        <span class="bp-user-name">
          <%= locals.user ? locals.user.full_name : 'Hark Emoyo' %>
        </span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </div>

      <a href="/" class="bp-home-link" title="Exit to Main LMS Portal">
        Dashboard
      </a>
    </div>
  </header>

  <!-- =========================================================================
       2. SECONDARY COURSE NAVIGATION BAR (Deep Plum / Aubergine #192F47)
       ========================================================================= -->
  <nav class="bp-course-nav">
    <div class="bp-nav-container">
      <button class="bp-nav-tab" id="tabNavHome" data-tab="home">Home</button>
      <button class="bp-nav-tab active" id="tabNavContent" data-tab="content">Content</button>
      <button class="bp-nav-tab" id="tabNavDiscussions" data-tab="discussions">Discussions</button>
      <button class="bp-nav-tab" id="tabNavGrades" data-tab="grades">Grades</button>
      
      <!-- Dropdown: Activities -->
      <div class="bp-nav-dropdown-item">
        <button class="bp-nav-tab has-dropdown">Activities <span>▾</span></button>
        <div class="bp-nav-submenu">
          <a href="javascript:void(0)" onclick="selectTopicByType('assignment')">Assignments</a>
          <a href="javascript:void(0)" onclick="selectTopicByType('quiz')">Quizzes &amp; Exams</a>
          <a href="javascript:void(0)" onclick="switchBrightspaceTab('discussions')">Cohort Discussions</a>
        </div>
      </div>

      <a class="bp-nav-tab" href="/library" id="tabNavLibrary">Library</a>
      <a class="bp-nav-tab" href="/transcript" id="tabNavTranscript">Transcript</a>
      <a class="bp-nav-tab" href="/courses/<%= course.id %>/certificate" id="tabNavCertificate">Certificate</a>
    </div>
  </nav>

  <!-- =========================================================================
       3. MAIN VIEW CONTAINER: CONTENT TAB (Split-Screen Unit Tree & Viewer)
       ========================================================================= -->
  <main class="bp-content-page" id="viewContent">
    <div class="bp-split-layout">

      <!-- LEFT SIDEBAR: Unit & Module Tree Navigation -->
      <aside class="bp-sidebar" aria-label="Course Table of Contents">
        <!-- Live Course Progress Summary -->
        <div class="bp-sidebar-progress-card" id="courseSidebarProgressCard">
          <div class="bp-sidebar-progress-top">
            <span class="bp-sidebar-progress-label">Your Course Progress</span>
            <span class="bp-sidebar-progress-pct" id="courseSidebarPct"><%= course.percent %>%</span>
          </div>
          <div class="progress-container bp-sidebar-progress-track">
            <div class="progress-bar" id="courseSidebarBar" data-percent="<%= course.percent %>"></div>
          </div>
          <div class="bp-sidebar-progress-meta" id="courseSidebarTopicsCount">
            <%= course.completedTopics %> of <%= course.totalTopics %> lessons completed
          </div>
        </div>

        <!-- Search Titles & Descriptions -->
        <div class="bp-search-wrap">
          <div class="bp-search-inner">
            <input type="text" id="unitSearchInput" class="bp-search-input" placeholder="Search titles, descriptions" aria-label="Search curriculum topics">
            <button class="bp-search-icon-btn" aria-label="Search button">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Modules Tree -->
        <div class="bp-tree-container" id="bpUnitsTree">
          <% 
            const modsList = course.modulesWithTopics || [];
            let defaultUnitIdx = modsList.findIndex(m => (m.completed_topics || 0) < (m.total_topics || (m.topics ? m.topics.length : 1)));
            if (defaultUnitIdx < 0) defaultUnitIdx = 0;
          %>
          <% modsList.forEach((mod, modIdx) => { %>
            <% 
              const isDefaultActiveUnit = (modIdx === defaultUnitIdx);
              const modTotal = (mod.topics && mod.topics.length) ? mod.topics.length : (mod.total_topics || 4);
              const modCompleted = Math.min(modTotal, mod.completed_topics || 0);
              const modPercent = modTotal > 0 ? Math.round((modCompleted / modTotal) * 100) : 0;
              let defaultTopicIdx = (mod.topics || []).findIndex(t => !t.completed);
              if (defaultTopicIdx < 0) defaultTopicIdx = 0;
            %>
            <div class="bp-unit-node <%= isDefaultActiveUnit ? 'expanded active-unit' : '' %> <%= modCompleted >= modTotal && modTotal > 0 ? 'module-complete' : '' %>" data-module-id="<%= mod.id %>" data-module-idx="<%= modIdx %>">
              
              <!-- Unit Header -->
              <div class="bp-unit-header">
                <button class="bp-unit-toggle-btn" aria-label="Toggle Unit">
                  <svg class="bp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
                <div class="bp-unit-title-group">
                  <span class="bp-unit-title"><%= mod.title %></span>
                  <span class="bp-unit-progress-text" id="modProgress-<%= mod.id %>"><%= modCompleted %>/<%= modTotal %> Completed (<%= modPercent %>%)</span>
                  <div class="bp-unit-mini-track">
                    <div class="bp-unit-mini-bar progress-bar" id="modBar-<%= mod.id %>" data-percent="<%= modPercent %>"></div>
                  </div>
                </div>
              </div>

              <!-- Topic Items under this Unit -->
              <div class="bp-topic-sublist">
                <% (mod.topics || []).forEach((topic, tIdx) => { %>
                  <% 
                    const isDefaultActiveTopic = isDefaultActiveUnit && tIdx === defaultTopicIdx;
                    const isTopicComplete = Boolean(topic.completed);
                  %>
                  <button type="button" 
                          class="bp-topic-item <%= isDefaultActiveTopic ? 'selected' : '' %> <%= isTopicComplete ? 'completed' : '' %>" 
                          data-topic-id="<%= topic.id %>"
                          data-module-id="<%= mod.id %>"
                          data-topic-type="<%= topic.type %>"
                          data-banner-title="<%= topic.bannerTitle || topic.title %>">
                    
                    <span class="bp-topic-icon">
                      <% if (topic.type === 'quiz') { %>
                        <!-- Quiz Icon (Question block) -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect width="18" height="18" x="3" y="3" rx="2" />
                          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                          <line x1="12" y1="17" x2="12.01" y2="17" stroke-width="3" />
                        </svg>
                      <% } else if (topic.type === 'assignment') { %>
                        <!-- Assignment Icon (Document with check/pencil) -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                          <polyline points="14 2 14 8 20 8" />
                          <path d="M9 15h6" />
                          <path d="M9 11h6" />
                        </svg>
                      <% } else { %>
                        <!-- Document Icon (Sheet with lines) -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                          <polyline points="14 2 14 8 20 8" />
                          <line x1="16" y1="13" x2="8" y2="13" />
                          <line x1="16" y1="17" x2="8" y2="17" />
                          <line x1="10" y1="9" x2="8" y2="9" />
                        </svg>
                      <% } %>
                    </span>

                    <div class="bp-topic-text-col">
                      <span class="bp-topic-label"><%= topic.title %></span>
                      <% if (topic.dueDate) { %>
                        <span class="bp-topic-submeta">Due: <%= topic.dueDate %></span>
                      <% } %>
                    </div>

                    <% if (isTopicComplete) { %>
                      <span class="bp-done-check" title="Completed">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                      </span>
                    <% } %>
                  </button>
                <% }); %>
              </div>

            </div>
          <% }); %>
        </div>
      </aside>

      <!-- RIGHT MAIN CONTENT PANE: Topic Viewer (Exact UoPeople Layout) -->
      <section class="bp-main-pane" aria-label="Topic Content Viewer">
        
        <!-- Top Toolbar: Download, Popout, Fullscreen, Previous / Next Topic -->
        <div class="bp-toolbar">
          <div class="bp-breadcrumb-trail">
            <span class="bp-crumb-root">Table of Contents</span>
            <span class="bp-crumb-sep">&gt;</span>
            <span class="bp-crumb-unit" id="toolbarUnitTitle"><%= course.title %></span>
            <span class="bp-crumb-sep">&gt;</span>
            <span class="bp-crumb-topic" id="toolbarTopicTitle">Unit 1 Overview</span>
          </div>

          <div class="bp-toolbar-actions">
            <!-- Download / Cloud -->
            <button class="bp-tool-btn" id="btnDownloadTopic" title="Download Topic Notes & Scripture PDF">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
                <path d="M12 12v9" />
                <path d="m8 17 4 4 4-4" />
              </svg>
            </button>

            <!-- Popout Window -->
            <button class="bp-tool-btn" id="btnPopoutTopic" title="Open lesson in new window">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </button>

            <!-- Fullscreen -->
            <button class="bp-tool-btn" id="btnFullscreenTopic" title="Expand to fullscreen">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
              </svg>
            </button>

            <div class="bp-tool-divider"></div>

            <!-- Previous / Next Chevrons -->
            <div class="bp-nav-arrows">
              <button class="bp-arrow-btn" id="btnPrevTopic" title="Previous Topic" aria-label="Previous Topic">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </button>
              <div class="bp-arrow-divider"></div>
              <button class="bp-arrow-btn" id="btnNextTopic" title="Next Topic" aria-label="Next Topic">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Topic Banner (Lavender Pattern + Crest + Amber Highlight Banner) -->
        <div class="bp-topic-banner">
          <div class="bp-banner-decor-grid"></div>
          
          <div class="bp-banner-content">
            <div class="bp-banner-crest">
              <img src="/images/IDA-Logo-Colored.webp" alt="Pastors LMS - Intentional Discipleship Africa Crest" class="bp-crest-img" width="124" height="96">
            </div>
            
            <!-- High-Contrast Golden Banner Badge -->
            <div class="bp-banner-badge" id="bannerBadgeTitle">
              Unit 1 Overview
            </div>
          </div>
        </div>

        <!-- Assigned Module / Course Instructor Contact Card -->
        <div class="bp-instructor-bar" id="moduleInstructorCard" hidden>
          <div class="bp-instructor-info">
            <div class="bp-instructor-avatar" id="instructorAvatar">T</div>
            <div>
              <div class="bp-instructor-label" id="instructorScopeLabel">Module Instructor</div>
              <div class="bp-instructor-name" id="instructorName">Instructor</div>
            </div>
          </div>
          <div class="bp-instructor-actions">
            <a href="#" id="btnWhatsAppInstructor" class="bp-instructor-wa" target="_blank" rel="noopener noreferrer" hidden>
              <span>💬 WhatsApp Instructor</span>
            </a>
            <a href="#" id="btnEmailInstructor" class="bp-instructor-email" hidden>
              <span>✉️ Email Instructor</span>
            </a>
          </div>
        </div>

        <!-- Topic Lesson Body Container -->
        <article class="bp-lesson-body" id="topicBodyContent">
          <!-- Populated dynamically via JavaScript with rich theological content -->
          <h3>Welcome to Unit 1: What is the Gospel?</h3>
          <p>In this opening unit, you will examine the single most crucial question in Christian theology and pastoral ministry: <em>What is the true gospel of Jesus Christ?</em> In many pulpits across Kenya and East Africa, the biblical gospel has been replaced with a gospel of financial accumulation, health guarantees, and human self-assertion.</p>

          <div class="scripture-focus-box">
            <h4>Maandiko ya Msingi (Scriptural Foundation)</h4>
            <p><strong>1 Corinthians 15:1-4:</strong> <em>"Now I would remind you, brothers, of the gospel I preached to you, which you received, in which you stand, and by which you are being saved... that Christ died for our sins in accordance with the Scriptures, that he was buried, that he was raised on the third day in accordance with the Scriptures."</em></p>
            <p><strong>Galatians 1:6-9:</strong> <em>"I am astonished that you are so quickly deserting him who called you in the grace of Christ and are turning to a different gospel—not that there is another one, but there are some who trouble you and want to distort the gospel of Christ."</em></p>
          </div>

          <h4>Learning Objectives</h4>
          <p>By the completion of Unit 1, you will be equipped to:</p>
          <ol>
            <li>Articulate the four foundational pillars of the biblical gospel: God, Man, Christ, and Response (Faith &amp; Repentance).</li>
            <li>Identify common counterfeits of the gospel circulating in contemporary African churches.</li>
            <li>Explain why adding human merit or financial gifts as prerequisites for salvation is anathema (Galatians 1:8).</li>
            <li>Teach your congregants to test sermons against the canonical apostolic witness.</li>
          </ol>

          <div class="pastoral-application-callout">
            <h4>Pastoral Context: The Kenyan Church</h4>
            <p>When congregants face real-world challenges—inflation, school fees, drought, or illness—the temptation to preach an easy transactional gospel is immense. Unit 1 grounds you in Christ's sufficient work, reminding our people that our ultimate treasure is reconciliation with Holy God, not earthly riches.</p>
          </div>
        </article>

        <!-- Topic Action Footer (Mark Complete & Navigation) -->
        <footer class="bp-topic-footer">
          <button type="button" class="btn btn-outline" id="footerBtnPrev">
            &larr; Previous Topic
          </button>
          
          <button type="button" class="btn btn-accent btn-mark-complete" id="btnMarkTopicComplete" data-course-id="<%= course.id %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span id="markCompleteBtnLabel">Mark as Completed</span>
          </button>

          <button type="button" class="btn btn-primary" id="footerBtnNext">
            Next Topic &rarr;
          </button>
        </footer>

      </section>

    </div>
  </main>

  <!-- =========================================================================
       4. COURSE HOME TAB (Course Overview, Announcement & Tasks Sidebar)
       ========================================================================= -->
  <main class="main-content" id="viewHome" style="display: none; padding-top: 24px;">
    <!-- Course Hero Summary -->
    <section class="course-hero">
      <div class="course-hero-banner-img">
        <img src="<%= course.cover_image %>" alt="<%= course.title %>">
      </div>

      <div class="course-hero-content">
        <div class="course-header-meta">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="course-code-tag"><%= course.code %></span>
            <span class="badge <%= course.status === 'current' ? 'badge-accent' : 'badge-success' %>">
              <%= course.term %> &bull; <%= course.status === 'current' ? 'In Progress' : 'Completed' %>
            </span>
          </div>

          <div class="course-dates-info">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <span>Term Schedule: <%= course.start_date %> to <%= course.end_date %></span>
          </div>
        </div>

        <h1 class="course-detail-title"><%= course.title %></h1>
        <p class="course-detail-desc"><%= course.description %></p>

        <!-- Metrics Strip -->
        <div class="course-stats-strip">
          <div class="course-stat-item">
            <div class="val" id="homeCoursePercent"><%= course.percent %>%</div>
            <div class="lbl">Course Completion</div>
          </div>
          <div style="width: 1px; height: 32px; background: var(--border);"></div>
          <div class="course-stat-item">
            <div class="val" id="homeTopicsVal"><%= course.completedTopics %> / <%= course.totalTopics %></div>
            <div class="lbl">Topics Completed</div>
          </div>
          <div style="width: 1px; height: 32px; background: var(--border);"></div>
          <div class="course-stat-item">
            <div class="val"><%= course.modules ? course.modules.length : 0 %> Units</div>
            <div class="lbl">Curriculum Units</div>
          </div>
          <div style="flex: 1; min-width: 200px; margin-left: auto;">
            <div class="progress-container" style="height: 10px;">
              <div class="progress-bar" id="homeOverallBar" data-percent="<%= course.percent %>"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Layout: Announcement + Tasks Sidebar -->
    <div class="dashboard-layout">
      <div class="course-main-col">
        <!-- Live Faculty Announcements Posted by Course Lecturer -->
        <% if (typeof liveAnnouncements !== 'undefined' && liveAnnouncements && liveAnnouncements.length) { %>
          <% liveAnnouncements.forEach(ann => { %>
            <div class="announcement-box announcement-box-live">
              <div class="announcement-header">
                <span class="announcement-title">📢 <%= ann.title %></span>
                <span class="announcement-date"><%= ann.author_name %> &middot; <%= new Date(ann.created_at).toLocaleDateString() %></span>
              </div>
              <p class="announcement-text"><%= ann.body %></p>
            </div>
          <% }) %>
        <% } %>

        <% if (course.announcement) { %>
          <div class="announcement-box" style="margin-bottom: 24px;">
            <div class="announcement-header">
              <span class="announcement-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                  <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                </svg>
                Faculty Announcement: <%= course.announcement.title %>
              </span>
              <span class="announcement-date"><%= course.announcement.date %></span>
            </div>
            <p class="announcement-text"><%= course.announcement.content %></p>
          </div>
        <% } %>

        <div class="home-action-box">
          <h3>Continue Your Pastoral Studies</h3>
          <p>You are enrolled in <strong><%= course.title %></strong>. Open <em>Content</em> for readings and assignments, <em>Discussions</em> to study with your cohort, or save this course for offline reading.</p>
          <div class="home-action-buttons">
            <button class="btn btn-primary" id="btnGoToContentFromHome">Open Course Content &rarr;</button>
            <button type="button" class="btn btn-secondary" id="btnSaveCourseOffline" data-course-url="/courses/<%= course.id %>">
              📥 Save Course for Offline Reading
            </button>
          </div>
          <p class="offline-save-hint" id="offlineSaveStatus">Saves this course's readings to your phone (uses a small amount of mobile data) so you can read without internet.</p>
        </div>
      </div>

      <%- include('partials/sidebar', { tasks: courseTasks.length > 0 ? courseTasks : allTasks }) %>
    </div>
  </main>

  <!-- =========================================================================
       5. COHORT DISCUSSION FORUM & PEER FEEDBACK VIEW
       ========================================================================= -->
  <main class="main-content bp-extra-tab" id="viewDiscussions" style="display: none;">
    <section class="bp-tab-card">
      <div class="bp-tab-head">
        <div>
          <h2>Weekly Cohort Discussion Forum</h2>
          <p>Share your biblical reflection for each unit and encourage fellow pastors across East Africa.</p>
        </div>
        <div class="discussion-unit-picker">
          <label class="form-label" for="discussionModuleSelect">Choose Unit:</label>
          <select id="discussionModuleSelect" class="form-input">
            <% (course.modulesWithTopics || course.modules || []).forEach(m => { %>
              <option value="<%= m.id %>"><%= m.title %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- New Discussion Post Form -->
      <form id="newDiscussionForm" class="discussion-composer">
        <label class="form-label" for="discussionPostBody">Post Your Reflection for This Unit</label>
        <textarea id="discussionPostBody" class="assignment-textarea" rows="4"
          placeholder="Write your reflection grounded in Scripture and your local church experience..." required></textarea>
        <div class="assignment-actions-row">
          <button type="submit" class="btn btn-primary" id="btnSubmitDiscussionPost">Post to Cohort Forum</button>
          <span id="discussionPostStatus" class="assignment-saved-msg" hidden></span>
        </div>
      </form>

      <!-- Discussion Threads Container -->
      <div id="discussionThreadsList" class="discussion-threads-list">
        <p class="lecturer-subtitle">Loading cohort discussions...</p>
      </div>

      <!-- Peer Feedback Section (UoPeople-style peer encouragement) -->
      <div class="peer-review-section">
        <h3>Peer Review &amp; Encouragement</h3>
        <p>Read a fellow pastor's written reflection for this unit and share brief, Scripture-centered encouragement.</p>
        <div id="peerSubmissionsList" class="peer-submissions-list">
          <p class="lecturer-subtitle">Loading peer reflections...</p>
        </div>
      </div>
    </section>
  </main>

  <!-- =========================================================================
       6. STUDENT GRADEBOOK VIEW (Live Scores, Teacher Feedback, GPA)
       ========================================================================= -->
  <main class="main-content bp-extra-tab" id="viewGrades" style="display: none;">
    <section class="bp-tab-card">
      <div class="bp-tab-head">
        <div>
          <h2>Course Gradebook &mdash; <%= course.code %></h2>
          <p>Track your graded written assignments, unit quizzes, final exams, discussion participation, and instructor feedback.</p>
        </div>
        <div class="home-action-buttons">
          <a href="/transcript" class="btn btn-secondary" id="btnGradesToTranscript">Official Transcript</a>
          <a href="/courses/<%= course.id %>/certificate" class="btn btn-primary" id="btnGradesToCertificate">Course Certificate</a>
        </div>
      </div>

      <div class="gradebook-summary-grid" id="gradebookSummaryGrid">
        <div class="gradebook-stat">
          <span>Course Progress</span>
          <strong id="gbProgressPct"><%= course.percent %>%</strong>
        </div>
        <div class="gradebook-stat">
          <span>Graded Items</span>
          <strong id="gbGradedCount"><%= gradeSummary ? gradeSummary.gradedCount : 0 %></strong>
        </div>
        <div class="gradebook-stat">
          <span>Average Score</span>
          <strong id="gbAveragePct"><%= (gradeSummary && gradeSummary.averagePercent !== null) ? gradeSummary.averagePercent + '%' : '—' %></strong>
        </div>
        <div class="gradebook-stat gradebook-stat-highlight">
          <span>Current Letter Grade</span>
          <strong id="gbLetterGrade"><%= gradeSummary ? gradeSummary.letterGrade : 'IP' %></strong>
        </div>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table" id="gradebookTable">
          <thead>
            <tr>
              <th>Assessment / Activity</th>
              <th>Type</th>
              <th>Score</th>
              <th>Grade</th>
              <th>Instructor Feedback</th>
            </tr>
          </thead>
          <tbody id="gradebookTableBody">
            <% if (gradeSummary && gradeSummary.items && gradeSummary.items.length) { %>
              <% gradeSummary.items.forEach(item => { %>
                <tr>
                  <td><strong><%= item.title %></strong></td>
                  <td><%= item.type %></td>
                  <td><%= item.score %> / <%= item.max_score %> (<%= item.percent %>%)</td>
                  <td><strong><%= item.letter %></strong></td>
                  <td><%= item.feedback || '—' %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5">No graded assessments recorded yet. Submit an assignment, quiz, or discussion post to build your gradebook.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <!-- Embed Rich Course Content into Client Script for Instant Fast Switching -->
  <div id="courseDataJson" hidden data-json="<%= JSON.stringify(course) %>"></div>
  <script src="/js/course-brightspace.js"></script>
</body>

</html>