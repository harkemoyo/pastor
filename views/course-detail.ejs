<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title || 'Course Details | Pastors LMS' %>
  </title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/course.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body class="app-container">

  <%- include('partials/header') %>

    <main class="main-content">
      <!-- Breadcrumb Nav -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Dashboard</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/">My Courses</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">
          <%= course.code %> — <%= course.title %>
        </span>
      </nav>

      <!-- Course Hero -->
      <section class="course-hero">
        <div class="course-hero-banner-img">
          <img src="<%= course.cover_image %>" alt="<%= course.title %>">
        </div>

        <div class="course-hero-content">
          <div class="course-header-meta">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="course-code-tag">
                <%= course.code %>
              </span>
              <span class="badge <%= course.status === 'current' ? 'badge-gold' : 'badge-success' %>">
                <%= course.term %> • <%= course.status==='current' ? 'In Progress' : 'Completed' %>
              </span>
            </div>

            <div class="course-dates-info">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              <span>Term Schedule: <%= course.start_date %> to <%= course.end_date %></span>
            </div>
          </div>

          <h1 class="course-detail-title">
            <%= course.title %>
          </h1>
          <p class="course-detail-desc">
            <%= course.description %>
          </p>

          <!-- Course Summary Metrics -->
          <div class="course-stats-strip">
            <div class="course-stat-item">
              <div class="val" id="courseOverallPct">
                <%= course.percent %>%
              </div>
              <div class="lbl">Course Completion</div>
            </div>
            <div style="width: 1px; height: 32px; background: var(--border);"></div>
            <div class="course-stat-item">
              <div class="val" id="courseCompletedTopicsVal">
                <%= course.completedTopics %> / <%= course.totalTopics %>
              </div>
              <div class="lbl">Topics Completed</div>
            </div>
            <div style="width: 1px; height: 32px; background: var(--border);"></div>
            <div class="course-stat-item">
              <div class="val">
                <%= course.modules ? course.modules.length : 0 %> Units
              </div>
              <div class="lbl">Syllabus Structure</div>
            </div>
            <div style="flex: 1; min-width: 200px; margin-left: auto;">
              <div class="progress-container" style="height: 10px;">
                <div class="progress-bar" id="courseOverallBar" style="width: <%= course.percent %>%;"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Sub Navigation Tabs (Brightspace / UoPeople Style) -->
      <div class="course-nav-tabs">
        <button class="c-tab-btn active">Course Home</button>
        <button class="c-tab-btn" onclick="alert('Navigating to full syllabus and study guide...')">Content &amp;
          Units</button>
        <button class="c-tab-btn" onclick="alert('Discussion Forum: Pastoral Cohort Exchange')">Cohort
          Discussions</button>
        <button class="c-tab-btn" onclick="alert('Quizzes and Exegesis Assignments')">Activities &amp; Quizzes</button>
        <button class="c-tab-btn" onclick="alert('Gradebook and Academic Standing')">Grades</button>
      </div>

      <!-- Course Layout (Modules / Syllabus + Sidebar) -->
      <div class="dashboard-layout">
        <div class="course-main-col">

          <!-- Course Announcement if present -->
          <% if (course.announcement) { %>
            <div class="announcement-box" style="margin-bottom: 24px;">
              <div class="announcement-header">
                <span class="announcement-title">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                  </svg>
                  Faculty Announcement: <%= course.announcement.title %>
                </span>
                <span class="announcement-date">
                  <%= course.announcement.date %>
                </span>
              </div>
              <p class="announcement-text">
                <%= course.announcement.content %>
              </p>
            </div>
            <% } %>

              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                <h2 style="font-size: 1.3rem; font-weight: 800;">Curriculum Modules &amp; Topics</h2>
                <span style="font-size: 0.82rem; color: var(--text-muted);">Click any unit to expand topics</span>
              </div>

              <!-- Modules Accordion List -->
              <div class="modules-list">
                <% (course.modules || []).forEach((mod, idx)=> { %>
                  <% const modPercent=mod.total_topics> 0 ? Math.round((mod.completed_topics / mod.total_topics) * 100)
                    : 0; %>
                    <div class="module-card <%= idx === 0 ? 'expanded' : '' %>" id="mod-card-<%= mod.id %>">
                      <div class="module-header">
                        <div class="module-title-col">
                          <div class="module-badge">
                            <%= mod.sort_order %>
                          </div>
                          <div class="module-title">
                            <%= mod.title %>
                          </div>
                        </div>

                        <div class="module-progress-col">
                          <span class="module-progress-text">
                            <strong>
                              <%= mod.completed_topics %>
                            </strong> of <%= mod.total_topics %> topics (<%= modPercent %>%)
                          </span>
                          <div class="progress-container" style="width: 90px; height: 6px;">
                            <div class="progress-bar" style="width: <%= modPercent %>%;"></div>
                          </div>
                          <svg class="module-toggle-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9" />
                          </svg>
                        </div>
                      </div>

                      <!-- Collapsible Content -->
                      <div class="module-topics" style="display: <%= idx === 0 ? 'block' : 'none' %>;">
                        <ul class="topics-list">
                          <% for (let t=1; t <=mod.total_topics; t++) { %>
                            <% const isDone=t <=(mod.completed_topics || 0); %>
                              <li class="topic-item <%= isDone ? 'completed' : '' %>">
                                <div class="topic-title-area">
                                  <span class="topic-type-icon">
                                    <% if (t % 3===1) { %>
                                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" title="Scripture Reading & Exegesis">
                                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                                      </svg>
                                      <% } else if (t % 3===2) { %>
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                                          stroke="currentColor" stroke-width="2" title="Pastoral Video Lecture">
                                          <polygon points="5 3 19 12 5 21 5 3" />
                                        </svg>
                                        <% } else { %>
                                          <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                                            stroke="currentColor" stroke-width="2" title="Ministry Application & Forum">
                                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                          </svg>
                                          <% } %>
                                  </span>
                                  <div>
                                    <span class="topic-name">
                                      Lesson <%= mod.sort_order %>.<%= t %>:
                                          <% if (t===1) { %>Biblical Foundation &amp; Scriptural Text (Exegesis)<% } %>
                                              <% if (t===2) { %>Historical Context &amp; Countering Errors<% } %>
                                                  <% if (t===3) { %>Local Church Application in Kenya<% } %>
                                                      <% if (t===4) { %>Sermon Preparation &amp; Homiletic Outline<% }
                                                          %>
                                                          <% if (t===5) { %>Pastoral Shepherding &amp; Accountability
                                                            Case Study<% } %>
                                                              <% if (t>= 6) { %>Unit Self-Quiz &amp; Discussion Cohort
                                                                Post<% } %>
                                    </span>
                                    <span class="topic-duration">• 25 mins</span>
                                  </div>
                                </div>

                                <button type="button" class="btn-topic-check" data-course-id="<%= course.id %>"
                                  data-module-id="<%= mod.id %>" title="Toggle completion status">
                                  <% if (isDone) { %>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                      stroke-width="3">
                                      <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    Completed
                                    <% } else { %>
                                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2">
                                        <circle cx="12" cy="12" r="9" />
                                      </svg>
                                      Mark Complete
                                      <% } %>
                                </button>
                              </li>
                              <% } %>
                        </ul>
                      </div>
                    </div>
                    <% }); %>
              </div>

        </div>

        <!-- Right Column: Work To Do for this Course -->
        <%- include('partials/sidebar', { tasks: courseTasks.length> 0 ? courseTasks : allTasks }) %>
      </div>
    </main>

    <script src="/js/app.js"></script>
</body>

</html>