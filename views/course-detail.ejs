      <div class="classlist-section">
        <h3 class="classlist-section-title">Assigned Faculty &amp; Lecturers</h3>
        <% if (!clsList.instructors || !clsList.instructors.length) { %>
          <div class="uop-empty-box">No specific lecturer assigned yet. Contact IDA Faculty Support at info@ida-africa.org.</div>
        <% } else { %>
          <div class="classlist-instructors-grid">
            <% clsList.instructors.forEach((inst, idx) => { %>
              <article class="classlist-inst-card" id="classlistInst-<%= idx %>">
                <div class="classlist-inst-head">
                  <div class="bp-instructor-avatar"><%= inst.initials || 'T' %></div>
                  <div>
                    <div class="bp-instructor-label"><%= inst.scopeLabel || 'Instructor' %></div>
                    <div class="bp-instructor-name"><%= inst.full_name %></div>
                  </div>
                </div>
                <div class="bp-instructor-actions">
                  <% if (inst.whatsapp_digits) { %>
                    <a href="https://wa.me/<%= inst.whatsapp_digits %>?text=<%= encodeURIComponent('Hello ' + inst.full_name + ', I am studying ' + course.code + '.') %>"
                       target="_blank" rel="noopener noreferrer" class="bp-instructor-wa" id="classlistWa-<%= idx %>">
                      WhatsApp
                    </a>
                  <% } %>
                  <% if (inst.email) { %>
                    <a href="mailto:<%= inst.email %>?subject=<%= encodeURIComponent(course.code + ' Student Question') %>"
                       class="bp-instructor-email" id="classlistEmail-<%= idx %>">
                      Email
                    </a>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Enrolled Cohort Pastors Section -->
      <div class="classlist-section">
        <h3 class="classlist-section-title">Cohort Pastors (<%= (clsList.students || []).length %>)</h3>
        <% if (!clsList.students || !clsList.students.length) { %>
          <div class="uop-empty-box">No classmates listed yet for this cohort.</div>
        <% } else { %>
          <div class="classlist-table-wrap">
            <table class="classlist-table" id="classlistStudentsTable">
              <thead>
                <tr>
                  <th>Pastor / Student</th>
                  <th>Role</th>
                  <th>Church / Ministry</th>
                  <th>Cohort</th>
                </tr>
              </thead>
              <tbody>
                <% clsList.students.forEach(st => { %>
                  <tr class="classlist-student-row">
                    <td>
                      <div class="classlist-person-cell">
                        <span class="classlist-avatar"><%= st.initials %></span>
                        <div>
                          <strong><%= st.full_name %></strong>
                          <div class="classlist-handle">@<%= st.username %></div>
                        </div>
                      </div>
                    </td>
                    <td><span class="badge badge-purple"><%= st.ministry_role %></span></td>
                    <td><%= st.church_name %></td>
                    <td><%= st.cohort %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <!-- Embed Rich Course Content into Client Script for Instant Fast Switching -->
  <div id="courseDataJson" hidden data-json="<%= JSON.stringify(course) %>"></div>
  <script src="/js/course-brightspace.js?v=<%= locals.assetVersion || '3' %>"></script>
</body>

</html>