<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= course.code %> - <%= course.title %> | Pastors LMS</title>
  <link rel="stylesheet" href="/css/global.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/footer.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/dashboard.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/course.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#192F47">
</head>

<body class="bp-lms-body">

  <!-- =========================================================================
       1. BRIGHTSPACE / UOPEOPLE TOP NAVBAR WITH REAL INTERACTIVE POPOVERS
       ========================================================================= -->
  <%
    const swCourses = (typeof switcherCourses !== 'undefined' && switcherCourses) ? switcherCourses : [course];
    const msgItems = (typeof inboxMessages !== 'undefined' && inboxMessages) ? inboxMessages : [];
    const discAlerts = (typeof discussionAlerts !== 'undefined' && discussionAlerts) ? discussionAlerts : [];
    const notifAlerts = (typeof notificationAlerts !== 'undefined' && notificationAlerts) ? notificationAlerts : [];
    const clsList = (typeof classlist !== 'undefined' && classlist) ? classlist : { instructors: [], students: [] };
    const primaryInst = course.courseInstructor || (clsList.instructors && clsList.instructors[0]) || null;
  %>
  <header class="bp-top-bar">
    <div class="bp-top-bar-inner">
      <div class="bp-top-left">
        <a href="/" class="bp-brand" id="bpBrandLogoLink" title="Return to Dashboard">
          <img src="/images/IDA-Logo-Complete.webp" alt="Pastors LMS - Intentional Discipleship Africa" class="bp-logo" width="93" height="72">
        </a>
        <div class="bp-top-divider"></div>
        <div class="bp-course-identity">
          <span class="bp-course-code"><%= course.code %>-01 &mdash; <%= course.term || 'AY2027-T1' %></span>
        </div>
      </div>

      <div class="bp-top-right">
        <!-- 1. 9-Dot Waffle Course Selector Popover -->
        <div class="bp-popover-wrap" id="wrapCourseSwitcher">
          <button type="button"
                  class="bp-icon-btn"
                  id="bpCourseLauncherBtn"
                  data-popover-trigger="popoverCourseSwitcher"
                  aria-expanded="false"
                  aria-controls="popoverCourseSwitcher"
                  title="Select a Course"
                  aria-label="Select a Course">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="4" height="4" rx="1" />
              <rect x="10" y="3" width="4" height="4" rx="1" />
              <rect x="17" y="3" width="4" height="4" rx="1" />
              <rect x="3" y="10" width="4" height="4" rx="1" />
              <rect x="10" y="10" width="4" height="4" rx="1" />
              <rect x="17" y="10" width="4" height="4" rx="1" />
              <rect x="3" y="17" width="4" height="4" rx="1" />
              <rect x="10" y="17" width="4" height="4" rx="1" />
              <rect x="17" y="17" width="4" height="4" rx="1" />
            </svg>
          </button>

          <div class="bp-popover bp-popover-wide" id="popoverCourseSwitcher" role="dialog" aria-label="Course Switcher" hidden>
            <div class="bp-popover-list" id="courseSwitcherList">
              <% swCourses.forEach(c => { %>
                <div class="bp-switcher-row <%= Number(c.id) === Number(course.id) ? 'is-current' : '' %>" data-course-id="<%= c.id %>">
                  <a href="/courses/<%= c.id %>" class="bp-switcher-link" id="switchCourseLink-<%= c.id %>">
                    <%= c.code %>-01 <%= c.title %> &mdash; <%= c.term %>
                  </a>
                  <button type="button"
                          class="bp-pin-btn"
                          id="pinCourseBtn-<%= c.id %>"
                          data-pin-course="<%= c.id %>"
                          aria-pressed="false"
                          title="Pin this course to the top"
                          aria-label="Pin <%= c.code %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M12 17v5" />
                      <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z" />
                    </svg>
                  </button>
                </div>
              <% }) %>
              <div class="bp-switcher-divider"></div>
              <a href="/library" class="bp-switcher-portal-link" id="switcherLibraryLink">Pastors Theological Library &mdash; Study Resources</a>
              <a href="/library?type=document" class="bp-switcher-portal-link" id="switcherGuidesLink">Printable Pastoral Study Guides</a>
              <a href="/" class="bp-switcher-portal-link" id="switcherDashboardLink">Pastoral Training Dashboard</a>
            </div>
          </div>
        </div>

        <div class="bp-icon-divider"></div>

        <!-- 2. Envelope: Instant Messages & Email Popover -->
        <div class="bp-popover-wrap" id="wrapMessages">
          <button type="button"
                  class="bp-icon-btn"
                  id="bpMessagesBtn"
                  data-popover-trigger="popoverMessages"
                  aria-expanded="false"
                  aria-controls="popoverMessages"
                  title="Instant Messages &amp; Email"
                  aria-label="Instant Messages and Email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <% if (msgItems.length > 0) { %>
              <span class="bp-notification-dot"></span>
            <% } %>
          </button>

          <div class="bp-popover bp-popover-wide" id="popoverMessages" role="dialog" aria-label="Course Messages" hidden>
            <div class="bp-msg-header">
              <button type="button" class="bp-msg-pill-btn is-active" id="btnToggleInstantComposer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                <span>Instant Messages</span>
              </button>
              <a href="mailto:<%= (primaryInst && primaryInst.email) ? primaryInst.email : 'info@ida-africa.org' %>?subject=<%= encodeURIComponent(course.code + ' Course Inquiry') %>"
                 class="bp-msg-email-link"
                 id="btnPopoverEmailInstructor">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
                <span>Email</span>
              </a>
            </div>

            <form class="bp-msg-composer" id="courseInstantMsgForm" data-course-id="<%= course.id %>">
              <label for="instantMsgInput" class="bp-sr-only">Send a message to your course instructor</label>
              <input type="text"
                     id="instantMsgInput"
                     class="bp-msg-input"
                     placeholder="Write a quick message to <%= primaryInst ? primaryInst.full_name : 'your instructor' %>..."
                     required>
              <button type="submit" class="btn btn-primary btn-sm" id="btnSendInstantMsg">Send</button>
            </form>

            <div class="bp-popover-feed" id="courseMessagesFeed">
              <% if (!msgItems.length) { %>
                <div class="bp-popover-empty">No recent instructor messages in <%= course.code %> yet.</div>
              <% } else { %>
                <% msgItems.slice(0, 6).forEach(m => { %>
                  <div class="bp-feed-item">
                    <div class="bp-feed-title">
                      <strong><%= m.sender %> (<%= m.senderRole %>)</strong> said:
                    </div>
                    <p class="bp-feed-text"><%= m.preview %></p>
                    <span class="bp-feed-time"><%= m.timeLabel %></span>
                  </div>
                <% }) %>
              <% } %>
            </div>

            <% if (primaryInst && primaryInst.whatsapp_digits) { %>
              <div class="bp-popover-footer">
                <a href="https://wa.me/<%= primaryInst.whatsapp_digits %>?text=<%= encodeURIComponent('Hello ' + primaryInst.full_name + ', I have a question about ' + course.code + '.') %>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="bp-popover-footer-link"
                   id="btnPopoverWhatsAppInstructor">
                  Message <%= primaryInst.full_name %> on WhatsApp &nearr;
                </a>
              </div>
            <% } %>
          </div>
        </div>

        <!-- 3. Speech Bubble: Cohort Discussion Subscription Alerts -->
        <div class="bp-popover-wrap" id="wrapDiscAlerts">
          <button type="button"
                  class="bp-icon-btn"
                  id="bpDiscussionsIconBtn"
                  data-popover-trigger="popoverDiscussions"
                  aria-expanded="false"
                  aria-controls="popoverDiscussions"
                  title="Cohort Discussion Alerts"
                  aria-label="Cohort Discussion Alerts">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          </button>

          <div class="bp-popover bp-popover-wide" id="popoverDiscussions" role="dialog" aria-label="Cohort Discussions" hidden>
            <div class="bp-popover-head">Cohort Discussion Activity</div>
            <div class="bp-popover-feed">
              <% if (!discAlerts.length) { %>
                <div class="bp-popover-empty">No cohort discussion posts yet. Be the first pastor to share a reflection!</div>
              <% } else { %>
                <% discAlerts.forEach(d => { %>
                  <button type="button"
                          class="bp-feed-item bp-feed-item-btn"
                          data-open-discussion-mod="<%= d.module_id %>"
                          id="discAlertBtn-<%= d.id %>">
                    <div class="bp-feed-title"><strong><%= d.author %></strong> in <%= d.module_title %></div>
                    <p class="bp-feed-text"><%= d.snippet %><%= d.snippet.length >= 110 ? '...' : '' %></p>
                    <span class="bp-feed-time"><%= d.timeLabel %></span>
                  </button>
                <% }) %>
              <% } %>
            </div>
            <div class="bp-popover-footer">
              <button type="button" class="bp-popover-footer-link" id="btnPopoverOpenDiscussions">
                Open All Cohort Discussions &rarr;
              </button>
            </div>
          </div>
        </div>

        <!-- 4. Bell: Update Alerts (Due Quizzes, Assignments, Grade Updates) -->
        <div class="bp-popover-wrap" id="wrapNotifications">
          <button type="button"
                  class="bp-icon-btn"
                  id="bpNotificationsBtn"
                  data-popover-trigger="popoverNotifications"
                  aria-expanded="false"
                  aria-controls="popoverNotifications"
                  title="Update Alerts"
                  aria-label="Update Alerts">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
              <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
            </svg>
            <% if (notifAlerts.length > 0) { %>
              <span class="bp-notification-dot"></span>
            <% } %>
          </button>

          <div class="bp-popover bp-popover-wide" id="popoverNotifications" role="dialog" aria-label="Update Alerts" hidden>
            <div class="bp-popover-head">Course Updates &amp; Deadlines</div>
            <div class="bp-popover-feed">
              <% if (!notifAlerts.length) { %>
                <div class="bp-popover-empty">You are all caught up with no pending deadlines!</div>
              <% } else { %>
                <% notifAlerts.forEach(alert => { %>
                  <a href="<%= alert.href %>"
                     class="bp-notif-item"
                     id="<%= alert.id %>"
                     data-notif-course="<%= alert.course_id %>"
                     data-notif-module="<%= alert.module_id || '' %>"
                     data-notif-topic="<%= alert.topic_id || '' %>"
                     data-notif-action="<%= alert.actionType %>">
                    <span class="bp-notif-icon bp-notif-icon-<%= alert.type %>" aria-hidden="true">
                      <% if (alert.type === 'quiz' || alert.type === 'exam') { %>
                        ?
                      <% } else if (alert.type === 'grade') { %>
                        &#9733;
                      <% } else if (alert.type === 'discussion') { %>
                        &#128172;
                      <% } else { %>
                        &#128196;
                      <% } %>
                    </span>
                    <span class="bp-notif-body">
                      <span class="bp-notif-headline"><%= alert.headline %></span>
                      <span class="bp-notif-sub"><%= alert.subline %></span>
                      <span class="bp-feed-time"><%= alert.timeLabel %></span>
                    </span>
                  </a>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>

        <div class="bp-icon-divider"></div>

        <!-- 5. User Avatar Profile Popover -->
        <div class="bp-popover-wrap" id="wrapUserProfile">
          <button type="button"
                  class="bp-user-pill"
                  id="bpUserProfileBtn"
                  data-popover-trigger="popoverUserProfile"
                  aria-expanded="false"
                  aria-controls="popoverUserProfile"
                  title="Account &amp; Academic Links">
            <span class="bp-avatar">
              <%= locals.user ? (locals.user.initials || 'P') : 'P' %>
            </span>
            <span class="bp-user-name">
              <%= locals.user ? locals.user.full_name : 'Pastor' %>
            </span>
          </button>

          <div class="bp-popover bp-popover-profile" id="popoverUserProfile" role="dialog" aria-label="User Profile Menu" hidden>
            <div class="bp-profile-summary">
              <strong><%= locals.user ? locals.user.full_name : 'Pastor' %></strong>
              <span>@<%= locals.user ? (locals.user.username || locals.user.student_id || 'student') : 'student' %></span>
            </div>
            <div class="bp-profile-links">
              <a href="/" id="profileMenuDashboard">Pastoral Dashboard</a>
              <a href="/courses" id="profileMenuCourses">My Courses</a>
              <a href="/transcript" id="profileMenuTranscript">Academic Progress (Unofficial Transcript)</a>
              <a href="/courses/<%= course.id %>/certificate" id="profileMenuCertificate">Course Certificate</a>
              <a href="/logout" class="bp-profile-logout" id="profileMenuLogout">Sign Out</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       2. SECONDARY COURSE NAVIGATION BAR (Exact UoPeople Organization)
       ========================================================================= -->
  <nav class="bp-course-nav" aria-label="Course sections">
    <div class="bp-nav-container">
      <button type="button" class="bp-nav-tab active" id="tabNavHome" data-tab="home">Home</button>
      <button type="button" class="bp-nav-tab" id="tabNavContent" data-tab="content">Content</button>

      <!-- Dropdown: Activities -->
      <div class="bp-nav-dropdown-item" id="activitiesDropdownWrap">
        <button type="button"
                class="bp-nav-tab has-dropdown"
                id="btnActivitiesDropdown"
                data-nav-dropdown="activitiesDropdownWrap"
                aria-expanded="false"
                aria-controls="activitiesDropdownMenu">
          Activities <span aria-hidden="true">&#9662;</span>
        </button>
        <div class="bp-nav-submenu" id="activitiesDropdownMenu" role="menu">
          <button type="button" id="btnActivitiesAssignments" role="menuitem" data-activity-action="assignment">Assignments</button>
          <button type="button" id="btnActivitiesDiscussions" role="menuitem" data-activity-action="discussions">Discussions</button>
          <button type="button" id="btnActivitiesQuizzes" role="menuitem" data-activity-action="quiz">Quizzes &amp; Exams</button>
        </div>
      </div>

      <button type="button" class="bp-nav-tab" id="tabNavClasslist" data-tab="classlist">Classlist</button>
      <button type="button" class="bp-nav-tab" id="tabNavGrades" data-tab="grades">Grades</button>

      <!-- Dropdown: Course Tools -->
      <div class="bp-nav-dropdown-item" id="courseToolsDropdownWrap">
        <button type="button"
                class="bp-nav-tab has-dropdown"
                id="btnCourseToolsDropdown"
                data-nav-dropdown="courseToolsDropdownWrap"
                aria-expanded="false"
                aria-controls="courseToolsDropdownMenu">
          Course Tools <span aria-hidden="true">&#9662;</span>
        </button>
        <div class="bp-nav-submenu" id="courseToolsDropdownMenu" role="menu">
          <button type="button" id="btnToolAnnouncements" role="menuitem" data-tool-action="announcements">Announcements</button>
          <button type="button" id="btnToolWorkToDo" role="menuitem" data-tool-action="worktodo">Work To Do &amp; Deadlines</button>
          <button type="button" id="btnToolOfflineSave" role="menuitem" data-tool-action="offline">Save Course for Offline</button>
          <a href="/transcript" id="btnToolTranscript" role="menuitem">Academic Progress (Transcript)</a>
          <a href="/courses/<%= course.id %>/certificate" id="btnToolCertificate" role="menuitem">Course Certificate</a>
        </div>
      </div>

      <!-- Dropdown: Learning Resources -->
      <div class="bp-nav-dropdown-item" id="resourcesDropdownWrap">
        <button type="button"
                class="bp-nav-tab has-dropdown"
                id="btnResourcesDropdown"
                data-nav-dropdown="resourcesDropdownWrap"
                aria-expanded="false"
                aria-controls="resourcesDropdownMenu">
          Learning Resources <span aria-hidden="true">&#9662;</span>
        </button>
        <div class="bp-nav-submenu" id="resourcesDropdownMenu" role="menu">
          <a href="/library" id="btnResLibrary" role="menuitem">Pastors Theological Library</a>
          <a href="/library?type=document" id="btnResStudyGuides" role="menuitem">Printable Study Guides</a>
          <a href="/library?type=link" id="btnResBibleTools" role="menuitem">Bible &amp; Exegesis Tools</a>
          <button type="button" id="btnResSyllabus" role="menuitem" data-tool-action="modules">Course Syllabus &amp; Modules</button>
        </div>
      </div>

      <!-- Dropdown: Help -->
      <div class="bp-nav-dropdown-item" id="helpDropdownWrap">
        <button type="button"
                class="bp-nav-tab has-dropdown"
                id="btnHelpDropdown"
                data-nav-dropdown="helpDropdownWrap"
                aria-expanded="false"
                aria-controls="helpDropdownMenu">
          Help <span aria-hidden="true">&#9662;</span>
        </button>
        <div class="bp-nav-submenu bp-nav-submenu-right" id="helpDropdownMenu" role="menu">
          <% if (primaryInst && primaryInst.whatsapp_digits) { %>
            <a href="https://wa.me/<%= primaryInst.whatsapp_digits %>?text=<%= encodeURIComponent('Hello ' + primaryInst.full_name + ', I need help with ' + course.code + '.') %>"
               target="_blank" rel="noopener noreferrer" id="btnHelpWhatsApp" role="menuitem">
              WhatsApp Course Instructor
            </a>
          <% } else { %>
            <a href="https://wa.me/254707821269?text=Hello%20Pastors%20LMS%20Support"
               target="_blank" rel="noopener noreferrer" id="btnHelpWhatsApp" role="menuitem">
              WhatsApp Pastoral Support
            </a>
          <% } %>
          <a href="mailto:<%= (primaryInst && primaryInst.email) ? primaryInst.email : 'info@ida-africa.org' %>" id="btnHelpEmail" role="menuitem">
            Email Faculty Support
          </a>
          <a href="/offline" id="btnHelpOffline" role="menuitem">Offline Reading Help</a>
        </div>
      </div>

      <a class="bp-nav-tab" href="/library?type=video" id="tabNavMediaLibrary">Media Library</a>
    </div>
  </nav>

  <!-- =========================================================================
       3. MAIN VIEW CONTAINER: CONTENT TAB (Split-Screen Unit Tree & Viewer)
       ========================================================================= -->
  <main class="bp-content-page bp-view-hidden" id="viewContent" hidden>
    <div class="bp-split-layout">

      <!-- LEFT SIDEBAR: Unit & Module Tree Navigation -->
      <aside class="bp-sidebar" aria-label="Course Table of Contents">
        <button type="button" class="bp-mobile-units-toggle" id="btnMobileUnitsToggle" aria-expanded="false" aria-controls="bpSidebarTreeBody">
          <span id="mobileUnitsToggleLabel">Course Units &amp; Lessons</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <div class="bp-sidebar-body is-collapsed" id="bpSidebarTreeBody">
        <!-- Live Course Progress Summary -->
        <div class="bp-sidebar-progress-card" id="courseSidebarProgressCard">
          <div class="bp-sidebar-progress-top">
            <span class="bp-sidebar-progress-label">Your Course Progress</span>
            <span class="bp-sidebar-progress-pct" id="courseSidebarPct"><%= course.percent %>%</span>
          </div>
          <div class="progress-container bp-sidebar-progress-track">
            <div class="progress-bar" id="courseSidebarBar" data-percent="<%= course.percent %>"></div>
          </div>
          <div class="bp-sidebar-progress-meta" id="courseSidebarTopicsCount">
            <%= course.completedTopics %> of <%= course.totalTopics %> lessons completed
          </div>
        </div>

        <!-- Search Titles & Descriptions -->
        <div class="bp-search-wrap">
          <div class="bp-search-inner">
            <input type="text" id="unitSearchInput" class="bp-search-input" placeholder="Search titles, descriptions" aria-label="Search curriculum topics">
            <button class="bp-search-icon-btn" aria-label="Search button">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Modules Tree -->
        <div class="bp-tree-container" id="bpUnitsTree">
          <% 
            const modsList = course.modulesWithTopics || [];
            let defaultUnitIdx = modsList.findIndex(m => (m.completed_topics || 0) < (m.total_topics || (m.topics ? m.topics.length : 1)));
            if (defaultUnitIdx < 0) defaultUnitIdx = 0;
          %>
          <% modsList.forEach((mod, modIdx) => { %>
            <% 
              const isDefaultActiveUnit = (modIdx === defaultUnitIdx);
              const modTotal = (mod.topics && mod.topics.length) ? mod.topics.length : (mod.total_topics || 4);
              const modCompleted = Math.min(modTotal, mod.completed_topics || 0);
              const modPercent = modTotal > 0 ? Math.round((modCompleted / modTotal) * 100) : 0;
              let defaultTopicIdx = (mod.topics || []).findIndex(t => !t.completed);
              if (defaultTopicIdx < 0) defaultTopicIdx = 0;
            %>
            <div class="bp-unit-node <%= isDefaultActiveUnit ? 'expanded active-unit' : '' %> <%= modCompleted >= modTotal && modTotal > 0 ? 'module-complete' : '' %>" data-module-id="<%= mod.id %>" data-module-idx="<%= modIdx %>">
              
              <!-- Unit Header -->
              <div class="bp-unit-header">
                <button class="bp-unit-toggle-btn" aria-label="Toggle Unit">
                  <svg class="bp-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
                <div class="bp-unit-title-group">
                  <span class="bp-unit-title"><%= mod.title %></span>
                  <span class="bp-unit-progress-text" id="modProgress-<%= mod.id %>"><%= modCompleted %>/<%= modTotal %> Completed (<%= modPercent %>%)</span>
                  <div class="bp-unit-mini-track">
                    <div class="bp-unit-mini-bar progress-bar" id="modBar-<%= mod.id %>" data-percent="<%= modPercent %>"></div>
                  </div>
                </div>
              </div>

              <!-- Topic Items under this Unit -->
              <div class="bp-topic-sublist">
                <% (mod.topics || []).forEach((topic, tIdx) => { %>
                  <% 
                    const isDefaultActiveTopic = isDefaultActiveUnit && tIdx === defaultTopicIdx;
                    const isTopicComplete = Boolean(topic.completed);
                  %>
                  <button type="button" 
                          class="bp-topic-item <%= isDefaultActiveTopic ? 'selected' : '' %> <%= isTopicComplete ? 'completed' : '' %>" 
                          data-topic-id="<%= topic.id %>"
                          data-module-id="<%= mod.id %>"
                          data-topic-type="<%= topic.type %>"
                          data-banner-title="<%= topic.bannerTitle || topic.title %>">
                    
                    <span class="bp-topic-icon">
                      <% if (topic.type === 'quiz') { %>
                        <!-- Quiz Icon (Question block) -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect width="18" height="18" x="3" y="3" rx="2" />
                          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                          <line x1="12" y1="17" x2="12.01" y2="17" stroke-width="3" />
                        </svg>
                      <% } else if (topic.type === 'assignment') { %>
                        <!-- Assignment Icon (Document with check/pencil) -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                          <polyline points="14 2 14 8 20 8" />
                          <path d="M9 15h6" />
                          <path d="M9 11h6" />
                        </svg>
                      <% } else { %>
                        <!-- Document Icon (Sheet with lines) -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                          <polyline points="14 2 14 8 20 8" />
                          <line x1="16" y1="13" x2="8" y2="13" />
                          <line x1="16" y1="17" x2="8" y2="17" />
                          <line x1="10" y1="9" x2="8" y2="9" />
                        </svg>
                      <% } %>
                    </span>

                    <div class="bp-topic-text-col">
                      <span class="bp-topic-label"><%= topic.title %></span>
                      <% if (topic.dueDate) { %>
                        <span class="bp-topic-submeta">Due: <%= topic.dueDate %></span>
                      <% } %>
                    </div>

                    <% if (isTopicComplete) { %>
                      <span class="bp-done-check" title="Completed">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                      </span>
                    <% } %>
                  </button>
                <% }); %>
              </div>

            </div>
          <% }); %>
        </div>
        </div>
      </aside>

      <!-- RIGHT MAIN CONTENT PANE: Topic Viewer (Exact UoPeople Layout) -->
      <section class="bp-main-pane" aria-label="Topic Content Viewer">
        
        <!-- Top Toolbar: Download, Popout, Fullscreen, Previous / Next Topic -->
        <div class="bp-toolbar">
          <div class="bp-breadcrumb-trail">
            <span class="bp-crumb-root">Table of Contents</span>
            <span class="bp-crumb-sep">&gt;</span>
            <span class="bp-crumb-unit" id="toolbarUnitTitle"><%= course.title %></span>
            <span class="bp-crumb-sep">&gt;</span>
            <span class="bp-crumb-topic" id="toolbarTopicTitle">Unit 1 Overview</span>
          </div>

          <div class="bp-toolbar-actions">
            <!-- Download / Cloud -->
            <button class="bp-tool-btn" id="btnDownloadTopic" title="Download Topic Notes & Scripture PDF">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242" />
                <path d="M12 12v9" />
                <path d="m8 17 4 4 4-4" />
              </svg>
            </button>

            <!-- Popout Window -->
            <button class="bp-tool-btn" id="btnPopoutTopic" title="Open lesson in new window">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
            </button>

            <!-- Fullscreen -->
            <button class="bp-tool-btn" id="btnFullscreenTopic" title="Expand to fullscreen">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
              </svg>
            </button>

            <div class="bp-tool-divider"></div>

            <!-- Previous / Next Chevrons -->
            <div class="bp-nav-arrows">
              <button class="bp-arrow-btn" id="btnPrevTopic" title="Previous Topic" aria-label="Previous Topic">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
              </button>
              <div class="bp-arrow-divider"></div>
              <button class="bp-arrow-btn" id="btnNextTopic" title="Next Topic" aria-label="Next Topic">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Topic Banner (Lavender Pattern + Crest + Amber Highlight Banner) -->
        <div class="bp-topic-banner">
          <div class="bp-banner-decor-grid"></div>
          
          <div class="bp-banner-content">
            <div class="bp-banner-crest">
              <img src="/images/IDA-Logo-Colored.webp" alt="Pastors LMS - Intentional Discipleship Africa Crest" class="bp-crest-img" width="124" height="96">
            </div>
            
            <!-- High-Contrast Golden Banner Badge -->
            <div class="bp-banner-badge" id="bannerBadgeTitle">
              Unit 1 Overview
            </div>
          </div>
        </div>

        <!-- Assigned Module / Course Instructor Contact Card -->
        <div class="bp-instructor-bar" id="moduleInstructorCard" hidden>
          <div class="bp-instructor-info">
            <div class="bp-instructor-avatar" id="instructorAvatar">T</div>
            <div>
              <div class="bp-instructor-label" id="instructorScopeLabel">Module Instructor</div>
              <div class="bp-instructor-name" id="instructorName">Instructor</div>
            </div>
          </div>
          <div class="bp-instructor-actions">
            <a href="#" id="btnWhatsAppInstructor" class="bp-instructor-wa" target="_blank" rel="noopener noreferrer" hidden>
              <span>💬 WhatsApp Instructor</span>
            </a>
            <a href="#" id="btnEmailInstructor" class="bp-instructor-email" hidden>
              <span>✉️ Email Instructor</span>
            </a>
          </div>
        </div>

        <!-- Topic Lesson Body Container -->
        <article class="bp-lesson-body" id="topicBodyContent">
          <!-- Populated dynamically via JavaScript with rich theological content -->
          <h3>Welcome to Unit 1: What is the Gospel?</h3>
          <p>In this opening unit, you will examine the single most crucial question in Christian theology and pastoral ministry: <em>What is the true gospel of Jesus Christ?</em> In many pulpits across Kenya and East Africa, the biblical gospel has been replaced with a gospel of financial accumulation, health guarantees, and human self-assertion.</p>

          <div class="scripture-focus-box">
            <h4>Maandiko ya Msingi (Scriptural Foundation)</h4>
            <p><strong>1 Corinthians 15:1-4:</strong> <em>"Now I would remind you, brothers, of the gospel I preached to you, which you received, in which you stand, and by which you are being saved... that Christ died for our sins in accordance with the Scriptures, that he was buried, that he was raised on the third day in accordance with the Scriptures."</em></p>
            <p><strong>Galatians 1:6-9:</strong> <em>"I am astonished that you are so quickly deserting him who called you in the grace of Christ and are turning to a different gospel—not that there is another one, but there are some who trouble you and want to distort the gospel of Christ."</em></p>
          </div>

          <h4>Learning Objectives</h4>
          <p>By the completion of Unit 1, you will be equipped to:</p>
          <ol>
            <li>Articulate the four foundational pillars of the biblical gospel: God, Man, Christ, and Response (Faith &amp; Repentance).</li>
            <li>Identify common counterfeits of the gospel circulating in contemporary African churches.</li>
            <li>Explain why adding human merit or financial gifts as prerequisites for salvation is anathema (Galatians 1:8).</li>
            <li>Teach your congregants to test sermons against the canonical apostolic witness.</li>
          </ol>

          <div class="pastoral-application-callout">
            <h4>Pastoral Context: The Kenyan Church</h4>
            <p>When congregants face real-world challenges—inflation, school fees, drought, or illness—the temptation to preach an easy transactional gospel is immense. Unit 1 grounds you in Christ's sufficient work, reminding our people that our ultimate treasure is reconciliation with Holy God, not earthly riches.</p>
          </div>
        </article>

        <!-- Topic Action Footer (Mark Complete & Navigation) -->
        <footer class="bp-topic-footer">
          <button type="button" class="btn btn-outline" id="footerBtnPrev">
            &larr; Previous Topic
          </button>
          
          <button type="button" class="btn btn-accent btn-mark-complete" id="btnMarkTopicComplete" data-course-id="<%= course.id %>">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span id="markCompleteBtnLabel">Mark as Completed</span>
          </button>

          <button type="button" class="btn btn-primary" id="footerBtnNext">
            Next Topic &rarr;
          </button>
        </footer>

      </section>

    </div>
  </main>

  <!-- =========================================================================
       4. COURSE HOME TAB (Course Overview, Announcement & Tasks Sidebar)
       ========================================================================= -->
  <main class="main-content" id="viewHome">
    <!-- Course Hero Summary -->
    <section class="course-hero">
      <div class="course-hero-banner">
        <img src="<%= course.cover_image %>" alt="" class="course-hero-banner-bg">
        <div class="course-hero-banner-scrim"></div>
        <div class="course-hero-banner-inner">
          <div class="course-header-meta">
            <div class="course-badge-group">
              <span class="course-code-tag"><%= course.code %></span>
              <span class="course-term-pill">
                <%= course.term %> &bull; <%= course.status === 'current' ? 'In Progress' : 'Completed' %>
              </span>
            </div>

            <div class="course-dates-info">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
              <span>Term Schedule: <%= course.start_date %> to <%= course.end_date %></span>
            </div>
          </div>

          <h1 class="course-detail-title"><%= course.title %></h1>
        </div>
      </div>

      <div class="course-hero-content">
        <p class="course-detail-desc"><%= course.description %></p>

        <!-- Metrics Strip -->
        <div class="course-stats-strip">
          <div class="course-stat-item">
            <div class="val" id="homeCoursePercent"><%= course.percent %>%</div>
            <div class="lbl">Course Completion</div>
          </div>
          <div class="course-stat-divider" aria-hidden="true"></div>
          <div class="course-stat-item">
            <div class="val" id="homeTopicsVal"><%= course.completedTopics %> / <%= course.totalTopics %></div>
            <div class="lbl">Topics Completed</div>
          </div>
          <div class="course-stat-divider" aria-hidden="true"></div>
          <div class="course-stat-item">
            <div class="val"><%= course.modules ? course.modules.length : 0 %> Units</div>
            <div class="lbl">Curriculum Units</div>
          </div>
          <div class="course-hero-progress-wrap">
            <div class="progress-container progress-container-lg">
              <div class="progress-bar" id="homeOverallBar" data-percent="<%= course.percent %>"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- UoPeople-style Two-Column Course Home: Announcements & Course Modules (Left) + Time & Work To Do (Right) -->
    <div class="dashboard-layout">
      <div class="course-main-col">
        <!-- 1. Announcements Collapsible Widget -->
        <section class="uop-widget" id="homeAnnouncementsWidget">
          <button type="button" class="uop-widget-toggle" id="btnToggleAnnouncements" aria-expanded="true" aria-controls="homeAnnouncementsBody">
            <span>Announcements</span>
            <svg class="uop-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
          <div class="uop-widget-body" id="homeAnnouncementsBody">
            <%
              const hasLiveAnn = typeof liveAnnouncements !== 'undefined' && liveAnnouncements && liveAnnouncements.length > 0;
              const hasBaseAnn = Boolean(course.announcement);
            %>
            <% if (!hasLiveAnn && !hasBaseAnn) { %>
              <div class="uop-empty-box">There are no announcements to display.</div>
            <% } else { %>
              <% if (hasLiveAnn) { %>
                <% liveAnnouncements.forEach(ann => { %>
                  <article class="announcement-box announcement-box-live">
                    <div class="announcement-header">
                      <span class="announcement-title">📢 <%= ann.title %></span>
                      <span class="announcement-date"><%= ann.author_name %> &middot; <%= new Date(ann.created_at).toLocaleDateString() %></span>
                    </div>
                    <p class="announcement-text"><%= ann.body %></p>
                  </article>
                <% }) %>
              <% } %>
              <% if (hasBaseAnn) { %>
                <article class="announcement-box">
                  <div class="announcement-header">
                    <span class="announcement-title"><%= course.announcement.title %></span>
                    <span class="announcement-date"><%= course.announcement.date %></span>
                  </div>
                  <p class="announcement-text"><%= course.announcement.content %></p>
                </article>
              <% } %>
            <% } %>
          </div>
        </section>

        <!-- 2. Course Modules 2-Column Card Grid Widget -->
        <section class="uop-widget uop-modules-widget" id="homeModulesWidget">
          <div class="uop-widget-head-row">
            <button type="button" class="uop-widget-toggle" id="btnToggleCourseModules" aria-expanded="true" aria-controls="homeModulesBody">
              <span>Course Modules</span>
              <svg class="uop-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>
            <div class="uop-modules-tools">
              <button type="button" class="btn btn-secondary btn-sm" id="btnSaveCourseOffline" data-course-url="/courses/<%= course.id %>">
                📥 Save for Offline
              </button>
              <button type="button" class="btn btn-primary btn-sm" id="btnGoToContentFromHome">
                Open Content &rarr;
              </button>
            </div>
          </div>
          <p class="offline-save-hint uop-offline-inline" id="offlineSaveStatus" hidden></p>

          <div class="uop-widget-body" id="homeModulesBody">
            <div class="uop-modules-grid">
              <% (course.modulesWithTopics || course.modules || []).forEach((mod, modIdx) => { %>
                <%
                  const topicsArr = Array.isArray(mod.topics) ? mod.topics : [];
                  const totalT = topicsArr.length || mod.total_topics || 0;
                  const doneT = topicsArr.filter(t => t.completed).length || mod.completed_topics || 0;
                  const modPct = totalT > 0 ? Math.round((doneT / totalT) * 100) : 0;
                %>
                <article class="uop-module-card <%= mod.isLocked ? 'is-locked' : '' %>"
                         id="homeModuleCard-<%= mod.id %>"
                         data-open-module="<%= mod.id %>"
                         tabindex="0"
                         role="button"
                         aria-label="Open <%= mod.title %>">
                  <div class="uop-module-cover">
                    <img src="<%= course.cover_image %>" alt="" loading="lazy">
                    <span class="uop-module-unit-pill">
                      <%= modIdx === 0 ? 'Overview' : `Unit ${modIdx}` %>
                    </span>
                    <% if (mod.isLocked) { %>
                      <span class="uop-module-lock-pill">🔒 Unlocks <%= mod.unlock_date %></span>
                    <% } %>
                  </div>
                  <div class="uop-module-body">
                    <h3 class="uop-module-title"><%= mod.title %></h3>
                    <div class="uop-module-progress-track">
                      <div class="uop-module-progress-bar" id="homeModBar-<%= mod.id %>" data-percent="<%= modPct %>"></div>
                    </div>
                    <div class="uop-module-progress-text" id="homeModCount-<%= mod.id %>">
                      <%= doneT %>/<%= totalT %> Topics Completed
                    </div>
                    <div class="uop-module-footer">
                      <span class="uop-module-doc-icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/>
                        </svg>
                      </span>
                      <% if (mod.due_date) { %>
                        <span class="uop-module-due-chip">Due <%= mod.due_date %></span>
                      <% } %>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>
          </div>
        </section>
      </div>

      <%- include('partials/sidebar', {
        workToDo: typeof workToDo !== 'undefined' ? workToDo : null,
        isCoursePage: true,
        courseInstructor: course.courseInstructor
      }) %>
    </div>
  </main>

  <!-- =========================================================================
       5. COHORT DISCUSSION FORUM & PEER FEEDBACK VIEW
       ========================================================================= -->
  <main class="main-content bp-extra-tab bp-view-hidden" id="viewDiscussions" hidden>
