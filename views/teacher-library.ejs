<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css?v=<%= locals.assetVersion || '4' %>">
  <link rel="stylesheet" href="/css/footer.css?v=<%= locals.assetVersion || '4' %>">
  <link rel="stylesheet" href="/css/dashboard.css?v=<%= locals.assetVersion || '4' %>">
  <link rel="stylesheet" href="/css/library.css?v=<%= locals.assetVersion || '4' %>">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#192F47">
</head>

<body class="app-container">
  <%- include('partials/header') %>

  <main class="main-content">
    <section class="library-hero">
      <div class="library-hero-copy">
        <span class="library-hero-eyebrow">Faculty &amp; Admin Portal</span>
        <h1 class="library-title">Manage Pastors Library</h1>
        <p class="library-subtitle">
          Share YouTube teaching videos, upload PDF study guides or audio lectures, or write printable notes directly for your students.
        </p>
      </div>
      <div class="library-hero-actions">
        <a href="/library" id="btnViewLibrary" class="btn btn-accent">View Library as a Student &rarr;</a>
      </div>
    </section>

    <% if (success) { %>
      <div class="library-alert library-alert-success" id="libraryAlertSuccess"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="library-alert library-alert-error" id="libraryAlertError"><%= error %></div>
    <% } %>

    <section class="library-panel">
      <div class="library-panel-head">
        <h2 class="library-panel-title">
          <%= editingItem ? 'Edit Library Material' : 'Add a New Library Material' %>
        </h2>
        <% if (editingItem) { %>
          <a href="/teacher/library" class="btn btn-secondary btn-sm" id="btnCancelEditMaterial">Cancel Editing</a>
        <% } %>
      </div>

      <form method="POST"
            action="<%= editingItem ? ('/teacher/library/' + editingItem.id + '/edit') : '/teacher/library' %>"
            id="addMaterialForm"
            class="library-form">
        <div class="form-group">
          <label class="form-label" for="materialTitle">Material Title</label>
          <input type="text"
                 id="materialTitle"
                 name="title"
                 class="form-input"
                 required
                 placeholder="e.g., Exposition of Romans 8 (Video Lecture)"
                 value="<%= formData.title || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="materialType">Category</label>
          <select id="materialType" name="type" class="form-input">
            <% types.forEach(t => { %>
              <option value="<%= t %>" <%= formData.type === t ? 'selected' : '' %>>
                <%= t === 'document' ? 'Study Guide / Document' : t.charAt(0).toUpperCase() + t.slice(1) %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="materialCourse">Linked Course (Optional)</label>
          <select id="materialCourse" name="course_id" class="form-input">
            <option value="">All Courses (General Ministry)</option>
            <% courses.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(formData.course_id || '') === String(c.id) ? 'selected' : '' %>>
                <%= c.code %> &mdash; <%= c.title %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="materialDuration">Format / Length Label (Optional)</label>
          <input type="text"
                 id="materialDuration"
                 name="duration"
                 class="form-input"
                 placeholder="e.g., 15 min video, PDF Guide, 30 min audio"
                 value="<%= formData.duration || '' %>">
        </div>

        <div class="form-group library-form-wide">
          <label class="form-label" for="materialUrl">Web Address (YouTube, Vimeo, Google Drive, PDF, or Audio Link)</label>
          <input type="text"
                 id="materialUrl"
                 name="url"
                 class="form-input"
                 placeholder="https://www.youtube.com/watch?v=... (optional if uploading a file or writing notes below)"
                 value="<%= (formData.url && !String(formData.url).startsWith('/library/read/')) ? formData.url : '' %>">
          <span class="form-hint">YouTube &amp; Vimeo links automatically play inside the Pastors Library video modal.</span>
        </div>

        <% if (!editingItem) { %>
          <div class="form-group library-form-wide">
            <label class="form-label" for="materialFileUpload">Or Upload a PDF / Audio File (Max 4 MB)</label>
            <div class="library-file-box">
              <input type="file"
                     id="materialFileUpload"
                     accept=".pdf,.mp3,.m4a,.wav,.ogg,.doc,.docx,.txt"
                     class="form-input">
              <input type="hidden" id="uploadedFileName" name="uploaded_file_name" value="">
              <input type="hidden" id="uploadedFileData" name="uploaded_file_data" value="">
              <span class="library-file-status" id="materialFileStatus">Accepted: PDF, MP3, M4A, WAV, DOC, DOCX, TXT (up to 4 MB).</span>
            </div>
          </div>
        <% } %>

        <div class="form-group library-form-wide">
          <label class="form-label" for="materialDescription">Short Summary for Students</label>
          <textarea id="materialDescription"
                    name="description"
                    class="form-input"
                    rows="2"
                    placeholder="Briefly explain how this resource helps pastors in their studies and ministry..."><%= formData.description || '' %></textarea>
        </div>

        <div class="form-group library-form-wide">
          <label class="form-label" for="materialContentNotes">Or Write a Built-In Printable Study Guide (Optional)</label>
          <textarea id="materialContentNotes"
                    name="content_notes"
                    class="form-input"
                    rows="5"
                    placeholder="Paste or type study notes here. Start a line with ## for a main heading or ### for a subheading. Students can read and print it inside Pastors LMS without leaving the app."></textarea>
        </div>

        <div class="library-form-actions">
          <button type="submit" id="btnAddMaterial" class="btn btn-primary">
            <%= editingItem ? 'Save Changes' : 'Add to Pastors Library' %>
          </button>
          <% if (editingItem) { %>
            <a href="/teacher/library" class="btn btn-secondary">Cancel</a>
          <% } %>
        </div>
      </form>
    </section>

    <section class="library-panel">
      <div class="library-panel-head">
        <h2 class="library-panel-title">Published Library Materials (<%= items.length %>)</h2>
      </div>
      <% if (!items.length) { %>
        <p>No materials in the library yet.</p>
      <% } else { %>
        <div class="library-table-wrap">
          <table class="library-table" id="materialsTable">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Course</th>
                <th>Added By</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
                <tr id="row-<%= item.id %>">
                  <td>
                    <a href="<%= item.playbackMode === 'reader' ? ('/library/read/' + item.id) : item.url %>"
                       <%= item.playbackMode === 'reader' ? '' : 'target="_blank" rel="noopener noreferrer"' %>>
                      <strong><%= item.title %></strong>
                    </a>
                  </td>
                  <td>
                    <span class="library-type-pill library-type-<%= item.type %>">
                      <%= item.type === 'document' ? 'Study Guide' : item.type %>
                    </span>
                  </td>
                  <td><%= item.course ? item.course.code : 'All Courses' %></td>
                  <td><%= item.added_by_name || item.added_by %></td>
                  <td>
                    <div class="library-table-actions">
                      <a href="/teacher/library?edit=<%= encodeURIComponent(item.id) %>"
                         id="btnEdit-<%= item.id %>"
                         class="btn btn-secondary btn-sm">
                        Edit
                      </a>
                      <form method="POST"
                            action="/teacher/library/<%= item.id %>/delete"
                            data-confirm="Remove '<%= item.title %>' from the library?">
                        <button type="submit" id="btnRemove-<%= item.id %>" class="btn btn-danger btn-sm">
                          Remove
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/library.js?v=<%= locals.assetVersion || '4' %>"></script>
</body>

</html>
