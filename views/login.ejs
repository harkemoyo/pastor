<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Sign In | Pastors Learning Portal' %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body class="login-body">
  <div class="login-container">
    
    <!-- Top Organization Header -->
    <header class="login-top-brand">
      <img src="/images/IDA-Logo-Complete.png" alt="Intentional Discipleship Africa" class="main-portal-logo">
      <div class="brand-headings">
        <h1 class="brand-title">PASTORS <span class="brand-gold">LMS</span></h1>
        <p class="brand-sub">INTENTIONAL DISCIPLESHIP AFRICA • SHEPHERD TRAINING</p>
      </div>
    </header>

    <!-- Main Card -->
    <div class="login-card-container">
      
      <!-- Welcome Heading -->
      <div class="card-intro">
        <h2 class="card-title">Sign In to Your Learning Portal</h2>
        <p class="card-subtitle">
          Karibu! Enter your phone number, email, or student ID and password to access your courses.
        </p>
      </div>

      <!-- Remembered Pastor Card (Appears if user logged in previously on this device) -->
      <div id="rememberedUserBox" class="remembered-card" style="display: none;">
        <div class="remembered-avatar" id="rememberedAvatar">P</div>
        <div class="remembered-info">
          <div class="remembered-greeting">Welcome back,</div>
          <div class="remembered-name" id="rememberedName">Pastor</div>
        </div>
        <button type="button" id="btnUseRemembered" class="btn btn-sm btn-gold">
          Sign In as <span id="rememberedShortName">Pastor</span>
        </button>
        <button type="button" id="btnClearRemembered" class="btn-text-link" title="Use a different account">
          Use another account
        </button>
      </div>

      <!-- Error Alert Message -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="portal-alert portal-alert-danger" role="alert">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="alert-icon">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <div class="alert-body">
            <strong>Unable to sign in:</strong> <%= error %>
          </div>
        </div>
      <% } %>

      <!-- Direct Sign-In Form -->
      <form action="/login" method="POST" id="directLoginForm" class="portal-form">
        
        <!-- Field 1: Phone, Email, or Username -->
        <div class="form-field-group">
          <label class="field-label" for="loginIdentifier">
            Your Phone Number, Email, or Username
          </label>
          <span class="field-help-text">
            Enter your mobile number (e.g. <strong>0712 345 678</strong>), email, or student ID
          </span>
          <input 
            type="text" 
            id="loginIdentifier" 
            name="username" 
            class="field-input" 
            placeholder="e.g. 0712 345 678 or pastor@church.org" 
            value="<%= typeof username !== 'undefined' ? username : '' %>" 
            required 
            autocomplete="username"
            autofocus
          >
        </div>

        <!-- Field 2: Password with Show/Hide Toggle -->
        <div class="form-field-group">
          <div class="field-label-row">
            <label class="field-label" for="loginPassword">Your Password</label>
            <a href="#admin-help" class="forgot-link" id="linkForgotPassword">Forgot password?</a>
          </div>
          <div class="password-input-wrap">
            <input 
              type="password" 
              id="loginPassword" 
              name="password" 
              class="field-input password-field" 
              placeholder="Enter your secret password" 
              required 
              autocomplete="current-password"
            >
            <button type="button" id="btnTogglePassword" class="btn-pw-toggle" aria-label="Toggle password visibility">
              <span id="pwToggleIcon">👁️</span>
              <span id="pwToggleText">Show</span>
            </button>
          </div>
        </div>

        <!-- Remember Me Checkbox -->
        <div class="remember-row">
          <label class="custom-checkbox-label">
            <input type="checkbox" name="remember_me" value="1" checked id="rememberMeCheck">
            <span class="checkbox-text">Keep me signed in on this phone or computer</span>
          </label>
        </div>

        <!-- Big Submit Button -->
        <button type="submit" class="btn-primary-large" id="btnSubmitLogin">
          <span>Sign In to My Courses</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>

      </form>

      <!-- Section: Enrolled Pastors Quick Access -->
      <% if (typeof registeredPastors !== 'undefined' && registeredPastors.length > 0) { %>
        <div class="quick-pastors-section">
          <div class="quick-section-header">
            <h3 class="quick-title">Registered Pastors Quick Access</h3>
            <p class="quick-subtitle">Tap your name to quickly fill in your details:</p>
          </div>

          <div class="pastors-quick-grid">
            <% registeredPastors.forEach(function(pastor) { %>
              <button 
                type="button" 
                class="pastor-pill-btn" 
                data-identifier="<%= pastor.phone || pastor.username || pastor.email %>"
                data-name="<%= pastor.full_name %>"
                data-role="<%= pastor.role %>"
                data-isdemo="<%= pastor.username === 'p1001234' ? 'true' : 'false' %>"
              >
                <div class="pastor-pill-avatar">
                  <%= (pastor.full_name || 'Pastor').split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() %>
                </div>
                <div class="pastor-pill-details">
                  <strong class="pastor-pill-name"><%= pastor.full_name %></strong>
                  <span class="pastor-pill-church">
                    <%= pastor.church_name ? pastor.church_name : (pastor.role === 'admin' ? 'Curriculum Admin' : 'Student Pastor') %>
                  </span>
                </div>
              </button>
            <% }); %>
          </div>

          <!-- 1-Click Demo Shortcut for quick testing -->
          <div class="demo-shortcut-box">
            <button type="button" class="btn-demo-instant" id="btnDemoInstant">
              ⚡ <strong>Demo Account 1-Click Test:</strong> Sign in as Pastor James (STU-1001)
            </button>
          </div>
        </div>
      <% } %>

      <!-- Direct WhatsApp / Phone Assistance for Older Pastors -->
      <div class="pastor-help-card" id="admin-help">
        <div class="help-card-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </div>
        <div class="help-card-content">
          <h4>Need help signing in?</h4>
          <p>If you forgot your password or need your student code, our team is ready to assist you right now.</p>
          <div class="help-buttons-row">
            <a href="https://wa.me/254707821269?text=Hello%20Pastor%20Hark,%20I%20need%20help%20signing%20into%20the%20Pastors%20LMS%20portal." 
               target="_blank" 
               rel="noopener noreferrer" 
               class="btn-whatsapp">
              <span>💬 WhatsApp Administrator</span>
            </a>
            <a href="tel:+254707821269" class="btn-call">
              <span>📞 Call Support (+254 707 821 269)</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Registration link for new pastoral students -->
      <div class="card-footer-nav">
        <p>New pastor or church leader? <a href="/register">Apply to join the Pastoral Cohort</a></p>
      </div>

      <!-- Biblical Verse Anchor -->
      <div class="card-scripture-quote">
        “Holding fast the faithful word as taught, that he may be able by sound doctrine to exhort.”
        <span class="scripture-ref">— Titus 1:9</span>
      </div>

    </div>
  </div>

  <script src="/js/app.js"></script>
</body>

</html>