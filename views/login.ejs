<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title || 'Sign In | Pastors LMS' %>
  </title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/login.css">
</head>

<body>
  <div class="login-viewport">
    <div class="login-bg-pattern"></div>
    <div class="login-glow-1"></div>
    <div class="login-glow-2"></div>

    <div class="login-card">
      <div class="login-header">
        <img src="/images/logo.svg" alt="Pastors LMS" class="login-logo">
        <h1 class="login-title">Shepherd Portal</h1>
        <p class="login-subtitle">Equipping pastors with sound doctrine &amp; faithful biblical leadership for East
          Africa.</p>
      </div>

      <% if (typeof error !=='undefined' && error) { %>
        <div class="alert alert-danger" role="alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            style="flex-shrink: 0;">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
          </svg>
          <div>
            <%= error %>
          </div>
        </div>
        <% } %>

          <!-- Google OAuth Button -->
          <a href="/auth/google" class="btn btn-google">
            <svg width="18" height="18" viewBox="0 0 24 24">
              <path fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
              <path fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
              <path fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
              <path fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
            </svg>
            Continue with Google
          </a>

          <div class="divider">
            <span>or</span>
          </div>

          <form action="<%= typeof isRegister !== 'undefined' && isRegister ? '/register' : '/login' %>" method="POST"
            id="loginForm">
            <% if (typeof isRegister !=='undefined' && isRegister) { %>
              <div class="form-group">
                <label class="form-label" for="fullName">Full Name</label>
                <div class="input-wrapper">
                  <span class="input-icon">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>
                  </span>
                  <input type="text" id="fullName" name="full_name" class="form-input" placeholder="Pastor John Doe"
                    required autocomplete="name">
                </div>
              </div>
              <% } %>

                <div class="form-group">
                  <label class="form-label" for="loginEmail">Email Address</label>
                  <div class="input-wrapper">
                    <span class="input-icon">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <rect width="20" height="16" x="2" y="4" rx="2" />
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                      </svg>
                    </span>
                    <input type="email" id="loginEmail" name="email" class="form-input"
                      placeholder="pastor.name@church.org" value="<%= typeof email !== 'undefined' ? email : '' %>"
                      required autocomplete="email">
                  </div>
                </div>

                <div class="form-group">
                  <div class="form-label">
                    <label for="loginPass">Password</label>
                    <% if (typeof isRegister==='undefined' || !isRegister) { %>
                      <a href="#" onclick="alert('Demo Mode: Use demo1234 or click the 1-click button below.')">Forgot
                        password?</a>
                      <% } %>
                  </div>
                  <div class="input-wrapper">
                    <span class="input-icon">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2">
                        <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                      </svg>
                    </span>
                    <input type="password" id="loginPass" name="password" class="form-input"
                      placeholder="<%= typeof isRegister !== 'undefined' && isRegister ? 'Create a password (min 6 characters)' : 'Enter your password' %>"
                      required
                      autocomplete="<%= typeof isRegister !== 'undefined' && isRegister ? 'new-password' : 'current-password' %>">
                  </div>
                </div>

                <button type="submit" class="btn btn-primary btn-submit">
                  <%= typeof isRegister !=='undefined' && isRegister ? 'Create Account' : 'Sign In to Learning Portal'
                    %>
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="2.5">
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                </button>
          </form>

          <div class="auth-toggle">
            <%= typeof isRegister !=='undefined' && isRegister ? 'Already have an account? <a href="/login">Sign in</a>'
              : 'New to Pastors LMS? <a href="/register">Create an account</a>' %>
          </div>

          <% if (typeof isRegister==='undefined' || !isRegister) { %>
            <!-- 1-Click Demo Login Shortcuts -->
            <div class="demo-box">
              <div class="demo-title">Quick Demo Logins (1-Click)</div>
              <div class="demo-actions">
                <button type="button" class="btn-demo-pill" data-email="pastor.james@church.org" data-pass="demo1234"
                  title="Log in as Pastor James">
                  <strong>Pastor James</strong>
                  <span>Student • Kenya Cohort</span>
                </button>

                <button type="button" class="btn-demo-pill" data-email="admin@pastorslms.com" data-pass="admin1234"
                  title="Log in as Administrator">
                  <strong>Curriculum Admin</strong>
                  <span>Faculty &amp; LMS Admin</span>
                </button>
              </div>
            </div>
            <% } %>

              <p class="login-footer-note">
                “Holding fast the faithful word as taught, that he may be able by sound doctrine to exhort.” — Titus 1:9
              </p>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>

</html>