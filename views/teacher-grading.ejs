<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Grading Queue | Pastors LMS' %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>
<body class="app-container">
  <%- include('partials/header') %>

  <main class="admin-page">
    <div class="admin-topbar">
      <div>
        <h1 class="admin-title">Grading Queue &amp; Pastoral Feedback</h1>
        <p class="admin-subtitle">Review written assignments, learning journals, and weekly cohort discussions for your assigned modules.</p>
      </div>
      <div class="admin-actions">
        <a href="/teacher/classes" class="btn btn-secondary" id="btnBackToTeacherClasses">&larr; My Classes</a>
        <a href="/teacher/library" class="btn btn-outline" id="btnGradingToLibrary">Teacher Library</a>
      </div>
    </div>

    <% if (success) { %>
      <div class="alert alert-success" role="status"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>

    <!-- Filter Pills -->
    <div class="status-pill-list" role="navigation" aria-label="Filter submissions by grading status">
      <a href="/teacher/grading?status=all" class="status-pill <%= filterStatus === 'all' ? 'active' : '' %>" id="pillGradeAll">
        All Submissions <span class="pill-count"><%= pendingCount + gradedCount %></span>
      </a>
      <a href="/teacher/grading?status=pending" class="status-pill <%= filterStatus === 'pending' ? 'active' : '' %>" id="pillGradePending">
        Needs Grading <span class="pill-count"><%= pendingCount %></span>
      </a>
      <a href="/teacher/grading?status=graded" class="status-pill <%= filterStatus === 'graded' ? 'active' : '' %>" id="pillGradeDone">
        Graded <span class="pill-count"><%= gradedCount %></span>
      </a>
    </div>

    <!-- Written Submissions & Quiz Attempts -->
    <section class="admin-surface admin-section-spaced">
      <h2>Written Assignments, Journals &amp; Assessments (<%= submissions.length %>)</h2>
      <% if (!submissions || submissions.length === 0) { %>
        <div class="empty-state">
          <p>No student submissions match this filter yet. As pastors submit assignments or quizzes in your modules, they will appear here.</p>
        </div>
      <% } else { %>
        <% submissions.forEach(sub => { %>
          <article class="teacher-course-card" id="gradeSubCard-<%= sub.id %>">
            <div class="teacher-course-head">
              <div>
                <span class="badge badge-purple"><%= sub.course_code %></span>
                <span class="lecturer-scope-tag lecturer-scope-course"><%= sub.module_title %></span>
                <span class="lecturer-scope-tag <%= sub.status === 'graded' ? 'lecturer-scope-course' : 'lecturer-scope-module' %>">
                  <%= sub.status === 'graded' ? `Graded: ${sub.score}/${sub.max_score} (${sub.grade_letter})` : 'Awaiting Grade' %>
                </span>
                <% if (sub.peerAvgPercent !== null && sub.peerAvgPercent !== undefined) { %>
                  <span class="lecturer-scope-tag lecturer-scope-course">Peer Rubric Avg: <%= sub.peerAvgPercent %>% (<%= sub.peerReviews.length %>)</span>
                <% } %>
                <% if (sub.integrity_flagged) { %>
                  <span class="lecturer-scope-tag integrity-flag-pill">⚠️ Integrity Review Flagged</span>
                <% } %>
                <h3><%= sub.student_name %> (@<%= sub.student_username %>) — <%= sub.topic_title || sub.topic_id %></h3>
                <span class="lecturer-contact-meta">
                  Type: <%= sub.submission_type %> &middot; Attempt #<%= sub.attempt_number || 1 %> &middot; Submitted <%= new Date(sub.updated_at || sub.created_at).toLocaleString() %>
                  <% if (sub.submission_type === 'journal') { %> &middot; 🔒 Private Ministry Journal<% } %>
                </span>
              </div>
            </div>

            <% if (sub.content_text) { %>
              <div class="submission-response-box">
                <strong>Pastor's Submission:</strong>
                <p><%= sub.content_text %></p>
              </div>
            <% } %>

            <% if (sub.integrity_flagged && sub.integrity_flag_reason) { %>
              <div class="alert alert-danger">
                <strong>Integrity Note (<%= sub.integrity_flagged_by || 'Instructor' %>):</strong> <%= sub.integrity_flag_reason %>
              </div>
            <% } %>

            <form action="/teacher/submissions/<%= sub.id %>/grade" method="POST" class="grading-inline-form" id="gradeForm-<%= sub.id %>">
              <div class="grading-field-score">
                <label class="form-label" for="score-<%= sub.id %>">Score (0–<%= sub.max_score || 100 %>)</label>
                <input type="number" id="score-<%= sub.id %>" name="score" class="form-input" min="0" max="<%= sub.max_score || 100 %>"
                  value="<%= sub.score !== null && sub.score !== undefined ? sub.score : '' %>" required placeholder="e.g. 88">
              </div>
              <div class="grading-field-feedback">
                <label class="form-label" for="feedback-<%= sub.id %>">Pastoral Feedback</label>
                <input type="text" id="feedback-<%= sub.id %>" name="feedback" class="form-input"
                  value="<%= sub.feedback || '' %>" placeholder="Write encouraging biblical feedback for this pastor...">
              </div>
              <button type="submit" class="btn btn-primary" id="btnSaveGrade-<%= sub.id %>">Save Grade</button>
            </form>

            <form action="/teacher/submissions/<%= sub.id %>/flag" method="POST" class="flag-inline-form" id="flagForm-<%= sub.id %>">
              <% if (sub.integrity_flagged) { %>
                <input type="hidden" name="action" value="clear">
                <button type="submit" class="btn btn-outline btn-sm" id="btnClearFlag-<%= sub.id %>">Clear Integrity Flag</button>
              <% } else { %>
                <input type="hidden" name="action" value="flag">
                <input type="text" name="flag_reason" class="form-input flag-reason-input" placeholder="Optional academic integrity note (e.g. copied text)..." aria-label="Integrity flag reason">
                <button type="submit" class="btn btn-outline btn-sm" id="btnFlagSub-<%= sub.id %>">Flag for Integrity Review</button>
              <% } %>
            </form>
          </article>
        <% }) %>
      <% } %>
    </section>

    <!-- Discussion Participation Grading -->
    <section class="admin-surface admin-section-spaced">
      <h2>Weekly Discussion Forum Posts (<%= discussions.length %>)</h2>
      <% if (!discussions || discussions.length === 0) { %>
        <div class="empty-state">
          <p>No cohort discussion posts in your modules yet.</p>
        </div>
      <% } else { %>
        <% discussions.forEach(post => { %>
          <article class="teacher-course-card" id="gradePostCard-<%= post.id %>">
            <div class="teacher-course-head">
              <div>
                <span class="badge badge-purple"><%= post.course_code %></span>
                <span class="lecturer-scope-tag lecturer-scope-course"><%= post.module_title %></span>
                <% if (post.grade_score !== null && post.grade_score !== undefined) { %>
                  <span class="lecturer-scope-tag lecturer-scope-course">Graded: <%= post.grade_score %>/100</span>
                <% } else { %>
                  <span class="lecturer-scope-tag lecturer-scope-module">Ungraded Post</span>
                <% } %>
                <h3><%= post.author_name %> (@<%= post.author_username %>)</h3>
                <span class="lecturer-contact-meta">Posted <%= new Date(post.created_at).toLocaleString() %></span>
              </div>
            </div>

            <div class="submission-response-box">
              <p><%= post.body %></p>
            </div>

            <form action="/teacher/discussions/<%= post.id %>/grade" method="POST" class="grading-inline-form" id="gradePostForm-<%= post.id %>">
              <div class="grading-field-score">
                <label class="form-label" for="postScore-<%= post.id %>">Participation Score (0–100)</label>
                <input type="number" id="postScore-<%= post.id %>" name="score" class="form-input" min="0" max="100"
                  value="<%= post.grade_score !== null && post.grade_score !== undefined ? post.grade_score : '' %>" required placeholder="e.g. 90">
              </div>
              <div class="grading-field-feedback">
                <label class="form-label" for="postFeedback-<%= post.id %>">Instructor Comment</label>
                <input type="text" id="postFeedback-<%= post.id %>" name="feedback" class="form-input"
                  value="<%= post.grade_feedback || '' %>" placeholder="Comment on their theological reflection...">
              </div>
              <button type="submit" class="btn btn-primary" id="btnSavePostGrade-<%= post.id %>">Grade Post</button>
            </form>
          </article>
        <% }) %>
      <% } %>
    </section>

    <!-- Student Deadline Extensions -->
    <section class="admin-surface admin-section-spaced" id="deadlineExtensionsSection">
      <h2>Student Extension Requests &amp; Deadline Overrides (EAT)</h2>
      <p class="admin-subtitle">Review pastors' extension requests or directly grant extra time for ministry emergencies, bereavement, or rural connectivity outages.</p>

      <% const pendingReqs = (typeof extensionRequests !== 'undefined' ? extensionRequests : []).filter(r => r.status === 'pending'); %>
      <div class="ext-req-review-wrap" id="pendingExtensionRequestsList">
        <h3>Pending Extension Requests (<%= pendingReqs.length %>)</h3>
        <% if (pendingReqs.length === 0) { %>
          <p class="lecturer-subtitle">No pending deadline extension requests from pastors right now.</p>
        <% } else { %>
          <% pendingReqs.forEach(reqItem => { %>
            <article class="ext-req-review-card" id="extReqCard-<%= reqItem.id %>">
              <div class="ext-req-review-head">
                <div>
                  <span class="badge badge-purple"><%= reqItem.course_code %></span>
                  <span class="lecturer-scope-tag lecturer-scope-course"><%= reqItem.module_title %></span>
                  <strong><%= reqItem.student_name %> (@<%= reqItem.student_username %>)</strong>
                </div>
                <span class="lecturer-scope-tag lecturer-scope-module">Requested until <%= reqItem.requested_until %></span>
              </div>
              <p class="ext-req-reason">"<%= reqItem.reason %>"</p>
              <form action="/teacher/extension-requests/<%= reqItem.id %>/resolve" method="POST" class="ext-review-actions" id="extResolveForm-<%= reqItem.id %>">
                <div>
                  <label class="form-label" for="approveDate-<%= reqItem.id %>">Approve Until</label>
                  <input type="date" id="approveDate-<%= reqItem.id %>" name="approved_until" class="form-input" value="<%= reqItem.requested_until %>">
                </div>
                <div class="grading-field-feedback">
                  <label class="form-label" for="approveNote-<%= reqItem.id %>">Note to Pastor (Optional)</label>
                  <input type="text" id="approveNote-<%= reqItem.id %>" name="reviewer_note" class="form-input" placeholder="e.g. Praying with you — granted until Wednesday">
                </div>
                <button type="submit" name="decision" value="approve" class="btn btn-primary btn-sm" id="btnApproveExtReq-<%= reqItem.id %>">Approve Extension</button>
                <button type="submit" name="decision" value="deny" class="btn btn-outline btn-sm" id="btnDenyExtReq-<%= reqItem.id %>">Decline</button>
              </form>
            </article>
          <% }) %>
        <% } %>
      </div>

      <h3 class="admin-subhead-spaced">Grant Manual Deadline Extension</h3>
      <form action="/teacher/extensions" method="POST" class="extension-form-grid" id="extensionForm">
        <div>
          <label class="form-label" for="extStudentSelect">Pastor / Student</label>
          <select id="extStudentSelect" name="student_username" class="form-input" required>
            <option value="">Choose a student...</option>
            <% (students || []).forEach(st => { %>
              <option value="<%= st.username %>"><%= st.full_name || st.username %> (@<%= st.username %>)</option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="form-label" for="extCourseSelect">Course</label>
          <select id="extCourseSelect" name="course_id" class="form-input" required>
            <% (allowedCourses || []).forEach(c => { %>
              <option value="<%= c.id %>"><%= c.code %> — <%= c.title %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="form-label" for="extModuleSelect">Unit / Module</label>
          <select id="extModuleSelect" name="module_id" class="form-input" required>
            <% (allowedCourses || []).forEach(c => { %>
              <% (c.modules || []).forEach(m => { %>
                <option value="<%= m.id %>" data-course-id="<%= c.id %>"><%= c.code %>: <%= m.title %></option>
              <% }) %>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="form-label" for="extDateInput">Extended Until (11:59 PM EAT)</label>
          <input type="date" id="extDateInput" name="extended_until" class="form-input" required>
        </div>

        <div class="extension-reason-field">
          <label class="form-label" for="extReasonInput">Reason (Optional)</label>
          <input type="text" id="extReasonInput" name="reason" class="form-input" placeholder="e.g. Church funeral / rural connectivity">
        </div>

        <div class="extension-submit-wrap">
          <button type="submit" class="btn btn-primary" id="btnGrantExtension">Grant Extension</button>
        </div>
      </form>

      <% if (extensions && extensions.length > 0) { %>
        <div class="admin-table-wrap">
          <table class="admin-table" id="extensionsTable">
            <thead>
              <tr>
                <th>Pastor</th>
                <th>Course &amp; Unit</th>
                <th>Extended Until</th>
                <th>Reason</th>
                <th>Granted By</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% extensions.forEach(ext => { %>
                <tr>
                  <td><strong><%= ext.student_name %></strong> (@<%= ext.student_username %>)</td>
                  <td><%= ext.course_code %> &mdash; <%= ext.module_title %></td>
                  <td><strong><%= ext.extended_until %></strong></td>
                  <td><%= ext.reason || '—' %></td>
                  <td><%= ext.granted_by %></td>
                  <td>
                    <form action="/teacher/extensions/<%= ext.id %>/delete" method="POST">
                      <button type="submit" class="btn btn-outline btn-sm" id="btnDeleteExt-<%= ext.id %>">Revoke</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <script>
    (function () {
      var courseSel = document.getElementById('extCourseSelect');
      var modSel = document.getElementById('extModuleSelect');
      if (!courseSel || !modSel) return;
      function syncModules() {
        var cid = courseSel.value;
        var firstVisible = null;
        Array.prototype.forEach.call(modSel.options, function (opt) {
          var match = !cid || opt.getAttribute('data-course-id') === cid;
          opt.hidden = !match;
          opt.disabled = !match;
          if (match && !firstVisible) firstVisible = opt;
        });
        if (modSel.selectedOptions[0] && modSel.selectedOptions[0].hidden && firstVisible) {
          firstVisible.selected = true;
        }
      }
      courseSel.addEventListener('change', syncModules);
      syncModules();
    })();
  </script>

  <%- include('partials/footer') %>
</body>
</html>
