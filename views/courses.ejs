<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/footer.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/dashboard.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="stylesheet" href="/css/course.css?v=<%= locals.assetVersion || '3' %>">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#192F47">
</head>

<body class="app-container">
  <%- include('partials/header') %>

  <main class="main-content courses-main-narrow">
    <% if (locals.user && ['admin', 'super_admin'].includes(user.role)) { %>
      <div class="admin-course-notice">
        <span class="admin-course-notice-text">
          <strong>Admin View:</strong> You are previewing courses as students see them.
        </span>
        <a href="/admin/courses" class="btn btn-secondary admin-course-notice-btn" id="btnAdminManageCourses">
          <span>Manage Courses &amp; Units &rarr;</span>
        </a>
      </div>
    <% } %>

    <div class="section-header-row">
      <h1 class="section-title">My Courses</h1>
      <div class="course-tabs">
        <button class="course-tab-btn active" id="tabAll" data-filter="all">All (<%= courses.length %>)</button>
        <button class="course-tab-btn" id="tabCurrent" data-filter="current">Current Term (<%= stats.currentCount %>)</button>
        <button class="course-tab-btn" id="tabPast" data-filter="past">Completed Term (<%= stats.pastCount %>)</button>
      </div>
    </div>

    <div class="course-grid">
      <% courses.forEach(course => { %>
        <article class="course-card" data-status="<%= course.status %>">
          <div class="course-card-thumb">
            <img src="<%= course.cover_image %>" alt="<%= course.title %>" loading="lazy">
          </div>
          <div class="course-card-body">
            <div class="course-meta-tags">
              <span class="badge badge-purple"><%= course.code %></span>
              <span class="badge <%= course.status === 'current' ? 'badge-accent' : 'badge-success' %>"><%= course.term %></span>
            </div>
            <h3 class="course-card-title"><%= course.title %></h3>
            <p class="course-card-desc"><%= course.description %></p>
            <div class="course-card-footer">
              <div class="course-progress-header">
                <span>Progress (<%= course.completedTopics %>/<%= course.totalTopics %> topics)</span>
                <span class="course-progress-pct"><%= course.percent %>%</span>
              </div>
              <div class="progress-container">
                <div class="progress-bar" data-percent="<%= course.percent %>"></div>
              </div>
              <div class="course-action-row">
                <span class="course-module-count"><%= course.modules ? course.modules.length : 0 %> Units</span>
                <a href="/courses/<%= course.id %>" id="openCourse-<%= course.id %>" class="btn btn-primary btn-open-course">
                  <span>Open Course &amp; Lessons</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>

</html>

