<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/course.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body class="app-container">
  <%- include('partials/header') %>

  <main class="main-content">
    <div class="section-header-row">
      <h1 class="section-title">My Courses</h1>
      <div class="course-tabs">
        <button class="course-tab-btn active" id="tabAll" data-filter="all">All (<%= courses.length %>)</button>
        <button class="course-tab-btn" id="tabCurrent" data-filter="current">Current Term (<%= stats.currentCount %>)</button>
        <button class="course-tab-btn" id="tabPast" data-filter="past">Completed Term (<%= stats.pastCount %>)</button>
      </div>
    </div>

    <div class="course-grid">
      <% courses.forEach(course => { %>
        <article class="course-card" data-status="<%= course.status %>">
          <div class="course-card-thumb">
            <img src="<%= course.cover_image %>" alt="<%= course.title %>" loading="lazy">
          </div>
          <div class="course-card-body">
            <div class="course-meta-tags">
              <span class="badge badge-purple"><%= course.code %></span>
              <span class="badge <%= course.status === 'current' ? 'badge-gold' : 'badge-success' %>"><%= course.term %></span>
            </div>
            <h3 class="course-card-title"><%= course.title %></h3>
            <p class="course-card-desc"><%= course.description %></p>
            <div class="course-card-footer">
              <div class="course-progress-header">
                <span>Progress (<%= course.completedTopics %>/<%= course.totalTopics %> topics)</span>
                <span class="course-progress-pct"><%= course.percent %>%</span>
              </div>
              <div class="progress-container">
                <div class="progress-bar" data-percent="<%= course.percent %>"></div>
              </div>
              <div class="course-action-row">
                <span class="course-module-count"><%= course.modules ? course.modules.length : 0 %> Units</span>
                <a href="/courses/<%= course.id %>" id="openCourse-<%= course.id %>" class="btn btn-primary btn-open-course">
                  <span>Open Course &amp; Lessons</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>

</html>

