<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/library.css">
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body class="app-container">
  <%- include('partials/header') %>

  <main class="main-content">
    <section class="library-hero">
      <h1 class="library-title">Library</h1>
      <p class="library-subtitle">Videos, study notes and teaching materials shared by your teachers.</p>
      <% if (canManage) { %>
        <a href="/teacher/library" id="btnManageLibrary" class="btn btn-gold">Add or remove materials</a>
      <% } %>
    </section>

    <form method="GET" action="/library" class="library-toolbar" id="libraryFilterForm">
      <div class="library-tabs">
        <% [['all', 'All'], ['video', 'Videos'], ['document', 'Documents'], ['audio', 'Audio'], ['link', 'Links']].forEach(tab => { %>
          <a id="libraryTab-<%= tab[0] %>" class="library-tab <%= filters.type === tab[0] ? 'active' : '' %>"
            href="/library?type=<%= tab[0] %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>">
            <%= tab[1] %> (<%= counts[tab[0]] || 0 %>)
          </a>
        <% }) %>
      </div>
      <div class="library-search">
        <input type="hidden" name="type" value="<%= filters.type %>">
        <input type="search" id="librarySearch" name="search" class="form-input" placeholder="Search materials"
          value="<%= filters.search %>">
        <button type="submit" id="btnLibrarySearch" class="btn btn-primary">Search</button>
      </div>
    </form>

    <% if (!items.length) { %>
      <div class="library-empty" id="libraryEmpty">
        <p>No materials found yet. Please check back soon.</p>
      </div>
    <% } else { %>
      <div class="library-grid">
        <% items.forEach(item => { %>
          <article class="library-card" id="material-<%= item.id %>">
            <span class="badge badge-purple library-type"><%= item.type %></span>
            <h2 class="library-card-title"><%= item.title %></h2>
            <% if (item.description) { %>
              <p class="library-card-desc"><%= item.description %></p>
            <% } %>
            <p class="library-card-meta">
              <% if (item.course) { %><%= item.course.code %> · <% } %>Added by <%= item.added_by_name || 'Teacher' %>
            </p>
            <a href="<%= item.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary library-open"
              id="openMaterial-<%= item.id %>">
              <%= item.type === 'video' ? 'Watch' : item.type === 'audio' ? 'Listen' : 'Open' %>
            </a>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>

</html>

